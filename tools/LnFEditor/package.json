{
  "name": "lnf-editor",
  "version": "0.1.0",
  "description": "CEGUI LookNFeel Visual Editor for MT3",
  "main": "dist/main/index.js",
  "author": "MT3 Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-vite build && electron-builder --win",
    "package:dir": "electron-vite build && electron-builder --win --dir",
    "package:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "immer": "^10.1.1",
    "sharp": "^0.33.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.15.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.mt3.lnf-editor",
    "productName": "LnF Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LnF Editor"
    },
    "portable": {
      "artifactName": "LnF-Editor-${version}-Portable.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/sharp/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "looknfeel",
        "name": "CEGUI LookNFeel",
        "description": "CEGUI LookNFeel File",
        "role": "Editor"
      }
    ]
  }
}
