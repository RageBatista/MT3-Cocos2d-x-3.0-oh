{
    "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
    "description": "MT3 Lua language server configuration (2026-08-02)",
    "runtime.version": "Lua 5.1",
    "runtime.special": {
        "require": "require"
    },
    "diagnostics.disable": [
        "undefined-global",
        "duplicate-field",
        "param-type-mismatch",
        "missing-parameter"
    ],
    "workspace.ignoreDir": [
        ".git",
        ".codex",
        ".claude",
        ".trae",
        "build_logs",
        "lib",
        "plans",
        "scheme_doc"
    ],
    "workspace.maxPreload": 2000,
    "workspace.preloadFileSize": 500
}