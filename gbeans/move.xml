<?xml version="1.0" encoding="utf-8"?>
<namespace name="move">

	<bean name="CAutoMovePath" from="x巡游配置/x巡游路径总表" genxml="client">
		<variable name="id" type="int" fromCol="巡游路径ID"/>
		<variable name="paths" type="string" fromCol="路径组"/>

	</bean>

	<bean name="CAutoMovePathPoint" from="x巡游配置/x巡游路径子地图表" genxml="client">
		<variable name="id" type="int" fromCol="路径ID"/>
		<variable name="ridename" type="string" fromCol="巡游坐骑"/>
		<variable name="effectname" type="string" fromCol="绑定特效"/>
		<variable name="cameraz" type="int" fromCol="摄像机高度"/>
		<variable name="speed" type="int" fromCol="巡游速度"/>
		<variable name="sceneid" type="int" fromCol="场景ID"/>
		<variable name="pointcount" type="int" fromCol="路点总数"/>
		<variable name="points" type="vector" fromCol="寻路点1,寻路点2,寻路点3,寻路点4,寻路点5,寻路点6,寻路点7,寻路点8,寻路点9,寻路点10,寻路点11,寻路点12,寻路点13,寻路点14,寻路点15,寻路点16,寻路点17,寻路点18,寻路点19,寻路点20" value="string"/>

	</bean>

</namespace>