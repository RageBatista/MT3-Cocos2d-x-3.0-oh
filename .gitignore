# Android
/client/android/**/build/
/client/android/**/local.properties
/client/android/**/libs/arm64-v8a/
# Android NDK build outputs (obj/ contains .a, .so, .o intermediates)
/client/android/**/obj/
# Android APK resource mirrors are generated from /client/res_android/res.
/client/android/*/assets/res/
/.gradle/
/.idea/

