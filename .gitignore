Thumbs.db
desktop.ini

# Packed resources and binary assets
/client/res_win/
/client/res_ios/
/client/res_android/
/client/android/LocojoyProject/assets/res/
/client/resource/*
!/client/resource/res/
!/client/resource/res/**
# Map runtime data - large, not tracked (local only)
/client/resource/res/map/
# Cocos2d-x 2.2.6 Win32 formal Release runtime archive.
!/client/resource/bin/
/client/resource/bin/*
!/client/resource/bin/Release/
/client/resource/bin/Release/*
!/client/resource/bin/Release/MT3.exe
!/client/resource/bin/Release/libcocos2d.dll
!/client/resource/bin/Release/libCocosDenshion.dll
!/client/resource/bin/Release/libExtensions.dll
!/client/resource/bin/Release/lua51.dll
!/client/resource/bin/Release/lua51.lib
!/client/resource/bin/Release/libcurl.dll
!/client/resource/bin/Release/libtiff.dll
!/client/resource/bin/Release/glew32.dll
!/client/resource/bin/Release/iconv.dll
!/client/resource/bin/Release/pthreadVCE2.dll
!/client/resource/bin/Release/zlib1.dll
!/client/resource/bin/Release/msvcp120.dll
!/client/resource/bin/Release/msvcr120.dll

# Cocos2d-x 2.2.6 Win32 Debug runtime - not tracked (local only)
/client/resource/bin/Debug/

# Win32 project intermediates generated by VS2013/MSBuild.
/client/MT3Win32App/*Debug.win32/
/client/MT3Win32App/*Release.win32/

# Cocos2d-x 2.2.6 Win32 rebuilt third-party final artifacts.
!/dependencies/third-party-rebuild/
!/dependencies/third-party-rebuild/curl-7.48.0/
!/dependencies/third-party-rebuild/curl-7.48.0/builds/
!/dependencies/third-party-rebuild/curl-7.48.0/builds/libcurl-vc12-x86-release-dll-ipv6-sspi-winssl/
!/dependencies/third-party-rebuild/curl-7.48.0/builds/libcurl-vc12-x86-release-dll-ipv6-sspi-winssl/bin/
!/dependencies/third-party-rebuild/curl-7.48.0/builds/libcurl-vc12-x86-release-dll-ipv6-sspi-winssl/bin/libcurl.dll
!/dependencies/third-party-rebuild/curl-7.48.0/builds/libcurl-vc12-x86-release-dll-ipv6-sspi-winssl/lib/
!/dependencies/third-party-rebuild/curl-7.48.0/builds/libcurl-vc12-x86-release-dll-ipv6-sspi-winssl/lib/libcurl.lib
!/dependencies/third-party-rebuild/tiff-4.0.3/
!/dependencies/third-party-rebuild/tiff-4.0.3/libtiff/
!/dependencies/third-party-rebuild/tiff-4.0.3/libtiff/libtiff.dll
!/dependencies/third-party-rebuild/tiff-4.0.3/libtiff/libtiff.lib

