<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="yincang_mtg">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="YinCang"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Property Name="MousePassThroughEnabled" Value="True"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/ImageButton" Name="yincang_mtg/anniu">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="LuaClass" Value="YinCang"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="NormalImage" Value="set:fightui image:return"/>
			<Property Name="PushedImage" Value="set:fightui image:return"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="LuaMemberName" Value="m_pReturn"/>
			<Property Name="EnableClickAni" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{1,-98},{1,-112},{1,-12},{1,-17}}"/>
			<Property Name="LuaEventOnClicked" Value="HandleReturnClicked"/>
		</Window>
	</Window>
</GUILayout>
