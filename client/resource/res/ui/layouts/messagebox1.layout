<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="TaharezLook/StaticImage" Name="messagebox1/bg" >
        <Property Name="Image" Value="set:LoginBack2 image:CommonBack" />
        <Property Name="Scale" Value="x:1 y:1 z:1" />
        <Property Name="LuaClass" Value="MessageBox1Dlg" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="LuaForDialog" Value="False" />
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}" />
        <Property Name="AllowModalStateClick" Value="True" />
        <Property Name="DisplaySizeChangePosEnabled" Value="False" />
        <Window Type="TaharezLook/StaticImage" Name="messagebox1" >
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Image" Value="set:ccdiban1 image:duandi1" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="UnifiedAreaRect" Value="{{0.5,-263},{0.5,-159},{0.5,261},{0.5,144}}" />
            <Property Name="AllowModalStateClick" Value="True" />
            <Property Name="DisplaySizeChangePosEnabled" Value="False" />
            <Window Type="TaharezLook/dangebutton" Name="messagebox1/OK" >
                <Property Name="Font" Value="simhei-16" />
                <Property Name="Text" Value="确 定" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="SizeType" Value="Auto" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="EnableClickAni" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,164},{0,221},{0,360},{0,284}}" />
                <Property Name="AllowModalStateClick" Value="True" />
            </Window>
            <Window Type="TaharezLook/StaticText" Name="messagebox1/text" >
                <Property Name="Font" Value="simhei-16" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="TextColours" Value="tl:FF645246 tr:FF645246 bl:FF645246 br:FF645246" />
                <Property Name="BorderColour" Value="FFFFFFFF" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="HorzFormatting" Value="WordWrapCentred" />
                <Property Name="UnifiedAreaRect" Value="{{0,-70},{0,32},{0,429},{0,215}}" />
                <Property Name="HorizontalAlignment" Value="Centre" />
                <Property Name="AllowModalStateClick" Value="True" />
            </Window>
        </Window>
        <Window Type="TaharezLook/StaticImage" Name="messagebox1/gantanhou" >
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Image" Value="set:renwuui image:renwu_tishi" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="Visible" Value="False" />
            <Property Name="AlwaysOnTop" Value="True" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="ClippedByParent" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0.5,-32},{0.5,-184},{0.5,30},{0.5,-123}}" />
            <Property Name="AllowModalStateClick" Value="True" />
        </Window>
    </Window>
</GUILayout>
