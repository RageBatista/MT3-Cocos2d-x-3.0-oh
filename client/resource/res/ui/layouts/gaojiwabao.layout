        <Property Name="LuaClass" Value="supertreasuremap" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="LuaForDialog" Value="False" />
        <Property Name="UnifiedAreaRect" Value="{{0,126},{0,154},{0,311},{0,337}}" />
        <Property Name="MousePassThroughEnabled" Value="True" />
        <Window Type="TaharezLook/StaticImage" Name="gaojiwabao/jiantou" >
            <Property Name="Font" Value="simhei-12" />
