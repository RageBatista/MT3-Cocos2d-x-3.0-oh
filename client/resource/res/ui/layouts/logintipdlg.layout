<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="LoginTipDlg">
		<Property Name="EnableSound" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Property Name="MousePassThroughEnabled" Value="True"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Window Type="TaharezLook/StaticImage" Name="LoginTipDlg/back">
			<Property Name="Text" Value="欢迎name进入游戏"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,0},{0,20},{0,400},{0,100}}"/>
			<Property Name="BackgroundEnabled" Value="True"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
			<Property Name="MousePassThroughEnabled" Value="True"/>
		</Window>
	</Window>
</GUILayout>
