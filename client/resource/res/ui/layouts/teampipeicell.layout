<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticImage" Name="teampipeicell">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Image" Value="set:mainui image:wenzixianshi"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,246},{0,123}}"/>
		<Window Type="TaharezLook/StaticText" Name="teampipeicell/xingdongmubiao">
			<Property Name="Font" Value="simhei-13"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FFFFFF00 tr:FFFFFF00 bl:FFFFFF00 br:FFFFFF00"/>
			<Property Name="BorderColour" Value="FFFFFFFF"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,-3.92188},{0,4},{0,227.078},{0,34}}"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="teampipeicell/zidongpipei">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Text" Value="自动匹配中"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="110.0"/>
			<Property Name="VertExtent" Value="22.0001"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FFFFF2DF tr:FFFFF2DF bl:FFFFF2DF br:FFFFF2DF"/>
			<Property Name="BorderColour" Value="FFFFFFFF"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,-1.92187},{0,34},{0,226.078},{0,64}}"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
		</Window>
		<Window Type="TaharezLook/ImageButton" Name="teampipeicell/stopMatch">
			<Property Name="Font" Value="simhei-13"/>
			<Property Name="Text" Value="取 消"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="NormalImage" Value="set:ccui2 image:chuangjianjin"/>
			<Property Name="PushedImage" Value="set:ccui2 image:chuangjianjin"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="EnableClickAni" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,58},{0,68},{0,200},{0,118}}"/>
			<Property Name="NormalTextColour" Value="FFF6E8AF"/>
			<Property Name="ButtonBorderColour" Value="ff4b0400"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
			<Property Name="ButtonDefaultBorderEnable" Value="False"/>
			<Property Name="ButtonDefaultColourEnable" Value="False"/>
		</Window>
	</Window>
</GUILayout>
