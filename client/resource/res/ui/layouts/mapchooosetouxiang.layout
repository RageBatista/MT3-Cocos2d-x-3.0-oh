<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/common_goodstips" Name="mapchooosetouxiang">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="TipsGuajiImg"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,326},{0,198},{0,989},{0,498}}"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Window Type="TaharezLook/StaticText" Name="mapchooosetouxiang/text">
			<Property Name="Font" Value="simhei-16"/>
			<Property Name="Text" Value="地图名称"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="116.0"/>
			<Property Name="VertExtent" Value="29.3138"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="LuaMemberName" Value="m_txtName"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,218},{0,15},{0,418},{0,55}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/ScrollablePane" Name="mapchooosetouxiang/lists">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="HorzStepSize" Value="0.1"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="VertStepSize" Value="0.1"/>
			<Property Name="LuaMemberName" Value="m_scrollPane"/>
			<Property Name="HorzOverlapSize" Value="0.01"/>
			<Property Name="UnifiedAreaRect" Value="{{0,40},{0,68},{0,629},{0,277}}"/>
			<Property Name="VertOverlapSize" Value="0.01"/>
			<Property Name="HorzScrollPosition" Value="0.0"/>
			<Property Name="VertScrollPosition" Value="0.0"/>
			<Property Name="AllowModalStateClick" Value="True"/>
			<AutoWindow NameSuffix="__auto_container__">
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="ChildExtentsArea" Value="l:0 t:0 r:0 b:0"/>
			</AutoWindow>
		</Window>
	</Window>
</GUILayout>
