<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticImage" Name="anquansuojiechutixing">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Image" Value="set:laohuji image:dianka"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="ShouJiGuanLianTiXing"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-418},{0.5,-359},{0.5,420},{0.5,284}}"/>
		<Window Type="TaharezLook/StaticText" Name="anquansuojiechutixing/text1">
			<Property Name="Font" Value="simhei-14"/>
