			<Property Name="HorzExtent" Value="468.0"/>
			<Property Name="VertExtent" Value="102.637"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FF50321A tr:FF50321A bl:FF50321A br:FF50321A"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="WordWrapLeftAligned"/>
			<Property Name="UnifiedAreaRect" Value="{{0,213},{0,355},{0,687},{0,468}}"/>
