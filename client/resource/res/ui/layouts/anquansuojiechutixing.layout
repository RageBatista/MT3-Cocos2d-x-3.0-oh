			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="260.0"/>
			<Property Name="VertExtent" Value="25.6593"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FF50321A tr:FF50321A bl:FF50321A br:FF50321A"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,181},{0,309},{0,435},{0,341}}"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="anquansuojiechutixing/text2">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="如果7天内不进行手机关联操作将不再可使用拍卖行和红包功能，请您及时关联手机。"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="Visible" Value="False"/>
			<Property Name="HorzExtent" Value="429.0"/>
			<Property Name="VertExtent" Value="76.978"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FF50321A tr:FF50321A bl:FF50321A br:FF50321A"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="WordWrapLeftAligned"/>
			<Property Name="UnifiedAreaRect" Value="{{0,221},{0,346},{0,665},{0,459}}"/>
		</Window>
		<Window Type="TaharezLook/Button" Name="anquansuojiechutixing/btn">
			<Property Name="Font" Value="simhei-16"/>
			<Property Name="Text" Value="设置安全锁"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="LuaMemberName" Value="m_btn"/>
			<Property Name="EnableClickAni" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,329},{0,500},{0,560},{0,563}}"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="anquansuojiechutixing/text">
			<Property Name="Font" Value="hycyj-20"/>
