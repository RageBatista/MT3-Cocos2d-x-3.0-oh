			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,349},{0,231},{0,534},{0,274}}"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="anquansuojiechutixing/text3">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="当前为安全锁解除状态，您可以丢弃、分解和出售珍品道具，放生、出售、合成珍品宠物。请您谨慎操作，如想启用安全锁请返回上级菜单设置。"/>
