<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/ImageButton" Name="jueseshizhuangcell">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="EnableClickAni" Value="False"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,86},{0,88}}"/>
		<Window Type="TaharezLook/ItemCell" Name="jueseshizhuangcell/touxiang">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="ItemCellStyle" Value="IconExtend"/>
			<Property Name="UnifiedAreaRect" Value="{{0,3},{0,3},{0,82},{0,80}}"/>
			<Property Name="MousePassThroughEnabled" Value="True"/>
			<Window Type="TaharezLook/StaticImage" Name="jueseshizhuangcell/touxiang/jiahao">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Image" Value="set:huobanui image:huoban_jiahao"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="Visible" Value="False"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,5},{0,5},{0,83},{0,83}}"/>
