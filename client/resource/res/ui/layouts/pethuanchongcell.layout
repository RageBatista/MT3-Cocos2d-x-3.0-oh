<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="DefaultWindow" Name="pethuanchongcell" >
        <Property Name="Scale" Value="x:1 y:1 z:1" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="LuaForDialog" Value="True" />
        <Property Name="UnifiedAreaRect" Value="{{0,16},{0,16},{0,509},{0,114}}" />
        <Window Type="TaharezLook/CellGroupButton2" Name="pethuanchongcell/back" >
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="EnableClickAni" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0,3},{0,1},{0,352},{0,94}}" />
            <Window Type="TaharezLook/ItemCell" Name="pethuanchongcell/back/item" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="ItemCellStyle" Value="IconExtend" />
                <Property Name="UnifiedAreaRect" Value="{{0,6},{0,10},{0,78},{0,82}}" />
            </Window>
            <Window Type="TaharezLook/StaticText" Name="pethuanchongcell/back/name" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Text" Value="天气正好医啊" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="HorzExtent" Value="132" />
                <Property Name="VertExtent" Value="22.0001" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="TextColours" Value="tl:FFFFFFFF tr:FFFFFFFF bl:FFFFFFFF br:FFFFFFFF" />
                <Property Name="BorderColour" Value="FFFFFFFF" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,87},{0,8},{0,301},{0,48}}" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
            <Window Type="TaharezLook/StaticText" Name="pethuanchongcell/back/info" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Text" Value="天气" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="HorzExtent" Value="44" />
                <Property Name="VertExtent" Value="22.0001" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="TextColours" Value="tl:FF8C5E2A tr:FF8C5E2A bl:FF8C5E2A br:FF8C5E2A" />
                <Property Name="BorderColour" Value="FFFFFFFF" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,87},{0.516279,-5},{0,299},{0.516279,35}}" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
        </Window>
        <Window Type="TaharezLook/StaticImage" Name="pethuanchongcell/back/mark" >
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="AlwaysOnTop" Value="True" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="ImageSizeEnable" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0,4},{0,1},{0,81},{0,57}}" />
            <Property Name="MousePassThroughEnabled" Value="True" />
        </Window>
    </Window>
</GUILayout>
