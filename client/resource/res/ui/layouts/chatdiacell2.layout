<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="DefaultWindow" Name="chatdiacell2" >
        <Property Name="Font" Value="simhei-10" />
        <Property Name="Scale" Value="x:1 y:1 z:1" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="LuaForDialog" Value="True" />
        <Property Name="DragMoveEnable" Value="True" />
        <Property Name="UnifiedAreaRect" Value="{{0,-1},{0,0},{0.000781,416},{0,184}}" />
        <Window Type="TaharezLook/StaticText" Name="chatdiacell2/name" >
            <Property Name="Font" Value="simhei-11" />
            <Property Name="Text" Value="名称最长七个字" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="HorzExtent" Value="140" />
            <Property Name="VertExtent" Value="20.1719" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="TextColours" Value="tl:FF743A0F tr:FF743A0F bl:FF743A0F br:FF743A0F" />
            <Property Name="BorderColour" Value="FFFFFFFF" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="HorzFormatting" Value="RightAligned" />
            <Property Name="UnifiedAreaRect" Value="{{1,-291},{0,5},{1,-126},{0,34}}" />
        </Window>
        <Window Type="TaharezLook/common_chatbg_right" Name="chatdiacell2/textbg" >
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="UnifiedAreaRect" Value="{{1,-496},{0,36},{1,-200},{0,131}}" />
            <Property Name="HorizontalAlignment" Value="Right" />
