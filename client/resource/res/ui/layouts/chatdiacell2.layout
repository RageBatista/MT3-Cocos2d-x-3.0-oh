                <Property Name="Font" Value="simhei-10" />
                <Property Name="Text" Value="30秒" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="SizeType" Value="Auto" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="EnableClickAni" Value="False" />
                <Property Name="HoverTextColour" Value="ff000000" />
                <Property Name="UnifiedAreaRect" Value="{{1,-328},{0,10},{1,-78},{0,41}}" />
                <Property Name="NormalTextColour" Value="FF000000" />
                <Property Name="PushedTextColour" Value="ff000000" />
                <Property Name="DisabledTextColour" Value="ff000000" />
                <Property Name="HorizontalAlignment" Value="Right" />
            </Window>
            <Window Type="TaharezLook/StaticImage" Name="chatdiacell2/textbg/wenben/yuyin/icon" >
                <Property Name="Font" Value="simhei-12" />
