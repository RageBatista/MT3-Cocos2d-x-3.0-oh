<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/CellGroupButtoncwk" Name="petcell">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="EnableClickAni" Value="False"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,83},{0,77}}"/>
		<Window Type="TaharezLook/ItemCell" Name="petcell/touxiang">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
