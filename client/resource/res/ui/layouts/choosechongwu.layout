<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticImage" Name="choosechongwu">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="LimitWindowSize" Value="False"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-428},{0.5,-308},{0.5,428},{0.5,321}}"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/StaticText" Name="choosechongwu/titlename">
			<Property Name="Font" Value="hycyj-20"/>
			<Property Name="Text" Value="选择宠物"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="Visible" Value="False"/>
			<Property Name="HorzExtent" Value="132.0"/>
			<Property Name="VertExtent" Value="32.9678"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,162},{0,43},{0,362},{0,85}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/ScrollablePane" Name="choosechongwu/list">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="HorzStepSize" Value="0.1"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="VertStepSize" Value="0.1"/>
			<Property Name="HorzOverlapSize" Value="0.01"/>
			<Property Name="LimitWindowSize" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,-8},{0,88},{0,748},{0,491}}"/>
			<Property Name="VertOverlapSize" Value="0.01"/>
			<Property Name="HorzScrollPosition" Value="0.0"/>
			<Property Name="VertScrollPosition" Value="0.0"/>
			<Property Name="AllowModalStateClick" Value="True"/>
			<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
			<AutoWindow NameSuffix="__auto_container__">
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="ChildExtentsArea" Value="l:0 t:0 r:0 b:0"/>
			</AutoWindow>
		</Window>
		<Window Type="TaharezLook/StaticImage" Name="choosechongwu/tubiao">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Image" Value="set:jingjichang image:tubiao"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0.5,-139},{0,0},{0.5,140},{0,291}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/StaticImage" Name="choosechongwu/biankuang">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Image" Value="set:jingjichang image:jingjichang_diwen_you"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,189},{0,61},{0,319},{0,84}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/StaticImage" Name="choosechongwu/biankuang1">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Image" Value="set:jingjichang image:jingjichang_diwen_zuo"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0.05,491},{0.05,31},{0.05,621},{0.05,54}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="choosechongwu/text">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="除了外形,他们没有任何区别"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="325.0"/>
			<Property Name="VertExtent" Value="25.6593"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="BorderColour" Value="FF58381E"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,231},{0,568},{0,626},{0,613}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="choosechongwu/text1">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="左边是物理型宠物，右边是法术型宠物"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="Visible" Value="False"/>
			<Property Name="HorzExtent" Value="442.0"/>
			<Property Name="VertExtent" Value="25.6593"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="BorderColour" Value="FF58381E"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,85},{0,568},{0,770},{0,613}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
	</Window>
</GUILayout>
