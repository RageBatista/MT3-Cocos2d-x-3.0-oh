<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticImage" Name="ShareDialog">
		<Property Name="Image" Value="set:loginback1 image:CharacterCreatedback_r"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="CaptureDialog"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="DefaultWindow" Name="ShareDialog/top">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="ClippedByParent" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,0},{0,75},{0,1180},{0,633}}"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="ShareDialog/text">
			<Property Name="Font" Value="simhei-13"/>
			<Property Name="Text" Value="爱生活，爱梦幻"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="144.0"/>
			<Property Name="VertExtent" Value="23.8165"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FFF2DEC0 tr:FFF2DEC0 bl:FFF2DEC0 br:FFF2DEC0"/>
			<Property Name="BorderColour" Value="FF008745"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,100},{0,674},{0,1061},{0,704}}"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
		</Window>
	</Window>
</GUILayout>
