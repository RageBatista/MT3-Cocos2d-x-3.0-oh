<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/common_goodstips" Name="zhuanzhibaoshilist">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,361},{0,168},{0,663},{0,494}}"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Window Type="TaharezLook/StaticText" Name="zhuanzhibaoshilist/text">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="可选宝石"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="104.0"/>
			<Property Name="VertExtent" Value="25.6593"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,12},{0,5},{0,291},{0,55}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/ScrollablePane" Name="zhuanzhibaoshilist/list">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="HorzStepSize" Value="0.1"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="VertStepSize" Value="0.1"/>
			<Property Name="HorzOverlapSize" Value="0.01"/>
