<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="TaharezLook/ImageButton" Name="Accmpsm" >
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Scale" Value="x:1 y:1 z:1" />
        <Property Name="SizeType" Value="Auto" />
        <Property Name="AlwaysOnTop" Value="True" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="LuaForDialog" Value="True" />
        <Property Name="EnableClickAni" Value="False" />
		 <Property Name="SoundResource" Value="cc.ogg" />
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}" />
        <Property Name="VerticalAlignment" Value="Centre" />
        <Window Type="TaharezLook/common_jstextbg" Name="Accmpsm/bg" >
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="UnifiedAreaRect" Value="{{0,130},{0,-2},{0,906},{0,481}}" />
            <Property Name="VerticalAlignment" Value="Centre" />
            <Property Name="HorizontalAlignment" Value="Centre" />
            <Window Type="TaharezLook/StaticImage" Name="Accmpsm/bg/ccy" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="AlwaysOnTop" Value="True" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="ClippedByParent" Value="False" />
                <Property Name="UnifiedAreaRect" Value="{{0,531.3},{0,238.3},{0,709.55},{0,415.55}}" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
            <Window Type="DefaultWindow" Name="Accmpsm/bg/qimensm" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,155.5},{0,5.5},{0,492.75},{0,66.75}}" />
                <Property Name="HorizontalAlignment" Value="Centre" />
                <Window Type="TaharezLook/StaticImage" Name="Accmpsm/bg/ccbs1" >
                    <Property Name="Font" Value="simhei-12" />
                    <Property Name="Alpha" Value="0.5" />
                    <Property Name="Image" Value="set:ccui image:xiangyun" />
                    <Property Name="Scale" Value="x:1 y:1 z:1" />
                    <Property Name="EnableSound" Value="True" />
                    <Property Name="LuaForDialog" Value="True" />
                    <Property Name="UnifiedAreaRect" Value="{{0,39.5},{0,13.5},{0,66.75},{0,35.75}}" />
                </Window>
                <Window Type="TaharezLook/StaticImage" Name="Accmpsm/bg/ccbs2" >
                    <Property Name="Font" Value="simhei-12" />
                    <Property Name="Alpha" Value="0.5" />
                    <Property Name="Image" Value="set:ccui image:xiangyun1" />
                    <Property Name="Scale" Value="x:1 y:1 z:1" />
                    <Property Name="EnableSound" Value="True" />
                    <Property Name="LuaForDialog" Value="True" />
                    <Property Name="UnifiedAreaRect" Value="{{0,266.5},{0,13.5},{0,293.75},{0,35.75}}" />
                </Window>
                <Window Type="TaharezLook/StaticText" Name="Accmpsm/bg/qimensm/qimenggl" >
                    <Property Name="Font" Value="simhei-13" />
                    <Property Name="Text" Value="门派介绍" />
                    <Property Name="Scale" Value="x:1 y:1 z:1" />
                    <Property Name="HorzExtent" Value="96" />
                    <Property Name="VertExtent" Value="23.828" />
                    <Property Name="EnableSound" Value="True" />
                    <Property Name="TextColours" Value="tl:FFF4D8B9 tr:FFF4D8B9 bl:FFF4D8B9 br:FFF4D8B9" />
                    <Property Name="BorderColour" Value="FF003454" />
                    <Property Name="LuaForDialog" Value="True" />
                    <Property Name="HorzFormatting" Value="HorzCentred" />
                    <Property Name="UnifiedAreaRect" Value="{{0,65.4},{0,2.4},{0,264.65},{0,49.65}}" />
