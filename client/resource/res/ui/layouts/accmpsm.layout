                    <Property Name="UnifiedAreaRect" Value="{{0,241.3},{0,151.3},{0,674.55},{0,263.55}}" />
                </Window>
            </Window>
            <Window Type="TaharezLook/common_hengxiancc" Name="Accmpsm/bg/czy" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Alpha" Value="0.8" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="EnableSound" Value="True" />
