<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="TaharezLook/CellGroupButtoncwk" Name="pethechengcell" >
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Scale" Value="x:1 y:1 z:1" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="LuaForDialog" Value="True" />
        <Property Name="EnableClickAni" Value="False" />
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,83},{0,77}}" />
        <Window Type="DefaultWindow" Name="pethechengcell/text" >
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="UnifiedAreaRect" Value="{{0,230},{0,103},{0,418},{0,208}}" />
            <Property Name="MousePassThroughEnabled" Value="True" />
            <Window Type="TaharezLook/StaticText" Name="pethechengcell/text/name" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Text" Value="名字最多七个字" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="HorzExtent" Value="154" />
                <Property Name="VertExtent" Value="22.0001" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="BorderColour" Value="FFFFFFFF" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,22},{0,16},{0,180},{0,52}}" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
            <Window Type="TaharezLook/StaticText" Name="pethechengcell/text/lv" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Text" Value="Lv:" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="HorzExtent" Value="16" />
                <Property Name="VertExtent" Value="22.0001" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="BorderColour" Value="FFFFFFFF" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="HorzFormatting" Value="HorzCentred" />
                <Property Name="UnifiedAreaRect" Value="{{0,26},{0,61},{0,60},{0,81}}" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
        </Window>
        <Window Type="TaharezLook/ItemCell" Name="pethechengcell/itemcell" >
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="ItemCellStyle" Value="IconExtend" />
            <Property Name="UnifiedAreaRect" Value="{{0,5},{0,5},{0,79},{0,73}}" />
            <Property Name="MousePassThroughEnabled" Value="True" />
            <Window Type="TaharezLook/StaticText" Name="pethechengcell/text/dengji" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Text" Value="100" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="HorzExtent" Value="21" />
                <Property Name="VertExtent" Value="22.0001" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="BorderColour" Value="FF000000" />
                <Property Name="BorderEnable" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="HorzFormatting" Value="RightAligned" />
                <Property Name="UnifiedAreaRect" Value="{{0.05,26},{0.05,39},{0.05,67},{0.05,60}}" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
        </Window>
        <Window Type="TaharezLook/StaticImage" Name="pethechengcell/zhan" >
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Image" Value="set:chongwuui image:chongwu_zhan" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="UnifiedAreaRect" Value="{{0,47},{0,3},{0,82},{0,31}}" />
            <Property Name="MousePassThroughEnabled" Value="True" />
        </Window>
    </Window>
</GUILayout>
