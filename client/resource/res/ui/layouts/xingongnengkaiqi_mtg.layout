<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="xinkongnengkaiqi">
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/StaticImage" Name="kaiqixingongneng_mtg">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Image" Value="set:xingongneng image:gggggggg"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="LuaClass" Value="XinGongNengOpenDLG"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,205},{0,0},{0,1056},{0,851}}"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
			<Property Name="AllowModalStateClick" Value="True"/>
			<Window Type="TaharezLook/StaticImage" Name="kaiqixingongneng_mtg/image">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="AlwaysOnTop" Value="True"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="ClippedByParent" Value="False"/>
				<Property Name="UnifiedAreaRect" Value="{{0,376},{0,290},{0,476},{0,390}}"/>
				<Property Name="AllowModalStateClick" Value="True"/>
			</Window>
		</Window>
		<Window Type="TaharezLook/StaticImage" Name="xinkongnengkaiqi/xingon">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Image" Value="set:laohuji image:xingongnengkaiqi"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,437},{0,528},{0,831},{0,635}}"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
	</Window>
</GUILayout>
