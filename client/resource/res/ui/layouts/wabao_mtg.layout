<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/FrameWindow8" Name="wabao_mtg">
		<Property Name="Font" Value="simhei-20"/>
		<Property Name="Text" Value="掘 金"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="RollUpEnabled" Value="True"/>
		<Property Name="SizingEnabled" Value="False"/>
		<Property Name="TitlebarEnabled" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-378},{0.5,-342},{0.5,377},{0.5,345}}"/>
		<Property Name="DragMovingEnabled" Value="False"/>
		<Property Name="CloseButtonEnabled" Value="False"/>
		<Window Type="DefaultWindow" Name="wabao_mtg/list">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,13},{0,68},{0,742},{0,597}}"/>
		</Window>
		<Window Type="TaharezLook/Button" Name="wabao_mtg/btn">
			<Property Name="Font" Value="simhei-18"/>
			<Property Name="Text" Value="确认"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,284},{0,604},{0,471},{0,666}}"/>
		</Window>
		<Window Type="TaharezLook/ImageButton" Name="wabao_mtg/close">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="ModalState" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="NormalImage" Value="set:common image:common_X"/>
			<Property Name="PushedImage" Value="set:common image:common_X"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="ClippedByParent" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,677},{0,-15},{0,767},{0,75}}"/>
		</Window>
	</Window>
</GUILayout>
