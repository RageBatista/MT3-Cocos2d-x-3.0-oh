<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="insetyuyindialog">
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,154},{0,224}}"/>
		<Window Type="TaharezLook/CommonCaseFightfunction" Name="insetyuyindialog/diban">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,2},{0,0},{0,152},{0,220}}"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
			<Window Type="TaharezLook/StaticImage" Name="insetyuyindialog/huakai">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Image" Value="set:liaotian image:liaotian_yuyin_fasong"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,145},{0,149}}"/>
				<Property Name="HorizontalAlignment" Value="Centre"/>
			</Window>
			<Window Type="TaharezLook/StaticText" Name="insetyuyindialog/huakaitishi">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Text" Value="手指滑开\n取消发送"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="HorzExtent" Value="88.0"/>
				<Property Name="VertExtent" Value="43.9785"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="TextColours" Value="tl:FFF8ECDA tr:FFF8ECDA bl:FFF8ECDA br:FFF8ECDA"/>
				<Property Name="BorderColour" Value="FF003454"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="HorzFormatting" Value="HorzCentred"/>
				<Property Name="UnifiedAreaRect" Value="{{0,14},{0,154},{0,133},{0,201}}"/>
				<Property Name="HorizontalAlignment" Value="Centre"/>
			</Window>
			<Window Type="TaharezLook/StaticImage" Name="insetyuyindialog/songkai">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Image" Value="set:liaotian image:liaotian_yuyin_quxiao"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="LuaMemberName" Value="."/>
				<Property Name="UnifiedAreaRect" Value="{{0,0},{0,4},{0,145},{0,149}}"/>
				<Property Name="HorizontalAlignment" Value="Centre"/>
			</Window>
			<Window Type="TaharezLook/StaticText" Name="insetyuyindialog/songkaitishi">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Text" Value="手指松开\n取消发送"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="HorzExtent" Value="88.0"/>
				<Property Name="VertExtent" Value="43.9785"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="TextColours" Value="tl:FFF8ECDA tr:FFF8ECDA bl:FFF8ECDA br:FFF8ECDA"/>
				<Property Name="BorderColour" Value="FF003454"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="HorzFormatting" Value="HorzCentred"/>
				<Property Name="UnifiedAreaRect" Value="{{0,14},{0,154},{0,133},{0,201}}"/>
				<Property Name="HorizontalAlignment" Value="Centre"/>
			</Window>
		</Window>
	</Window>
</GUILayout>
