<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticImage" Name="address1/mask">
		<Property Name="Image" Value="set:LoginBack2 image:CommonBack"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/FrameWindow3" Name="address">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Text" Value="地理位置"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="RollUpEnabled" Value="True"/>
			<Property Name="SizingEnabled" Value="False"/>
			<Property Name="TitlebarEnabled" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0.5,-331},{0.5,-274},{0.5,331},{0.5,274}}"/>
			<Property Name="DragMovingEnabled" Value="False"/>
			<Property Name="AllowModalStateClick" Value="True"/>
			<Window Type="TaharezLook/common_text2bg" Name="address/di">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,28},{0,75},{0,633},{0,503}}"/>
				<Property Name="AllowModalStateClick" Value="True"/>
				<Window Type="TaharezLook/StaticText" Name="address/now">
					<Property Name="Font" Value="simhei-14"/>
					<Property Name="Text" Value="当前位置："/>
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="HorzExtent" Value="130.0"/>
					<Property Name="VertExtent" Value="25.6593"/>
					<Property Name="EnableSound" Value="True"/>
					<Property Name="TextColours" Value="tl:FF50321A tr:FF50321A bl:FF50321A br:FF50321A"/>
					<Property Name="BorderColour" Value="FF003454"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="UnifiedAreaRect" Value="{{0.05,118},{0.05,9},{0.05,245},{0.05,59}}"/>
					<Property Name="AllowModalStateClick" Value="True"/>
				</Window>
				<Window Type="TaharezLook/StaticText" Name="address/where">
					<Property Name="Font" Value="simhei-14"/>
					<Property Name="Text" Value="XX省XX市"/>
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="HorzExtent" Value="104.0"/>
					<Property Name="VertExtent" Value="25.6593"/>
					<Property Name="EnableSound" Value="True"/>
					<Property Name="TextColours" Value="tl:FF50321A tr:FF50321A bl:FF50321A br:FF50321A"/>
					<Property Name="BorderColour" Value="FF003454"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="UnifiedAreaRect" Value="{{0.05,241},{0.05,9},{0.05,559},{0.05,59}}"/>
					<Property Name="AllowModalStateClick" Value="True"/>
				</Window>
				<Window Type="TaharezLook/common_ty" Name="address/sheng">
					<Property Name="Font" Value="simhei-14"/>
					<Property Name="Text" Value="省"/>
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="SizeType" Value="Auto"/>
					<Property Name="EnableSound" Value="True"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="EnableClickAni" Value="True"/>
					<Property Name="UnifiedAreaRect" Value="{{0,12},{0,108},{0,196},{0,172}}"/>
					<Property Name="AllowModalStateClick" Value="True"/>
					<Window Type="TaharezLook/StaticImage" Name="address/sheng/down1">
						<Property Name="Font" Value="simhei-12"/>
						<Property Name="Image" Value="set:common image:dowm"/>
						<Property Name="Scale" Value="x:1 y:1 z:1"/>
						<Property Name="EnableSound" Value="True"/>
						<Property Name="LuaForDialog" Value="True"/>
						<Property Name="UnifiedAreaRect" Value="{{0,162},{0,24},{0,178},{0,41}}"/>
