						<Property Name="EnableSound" Value="True"/>
						<Property Name="LuaForDialog" Value="True"/>
						<Property Name="UnifiedAreaRect" Value="{{0,161},{0,24},{0,177},{0,41}}"/>
						<Property Name="AllowModalStateClick" Value="True"/>
					</Window>
				</Window>
				<Window Type="TaharezLook/dangebutton" Name="address/auto">
					<Property Name="Font" Value="simhei-16"/>
					<Property Name="Text" Value="自动获取"/>
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="SizeType" Value="Auto"/>
					<Property Name="EnableSound" Value="True"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="EnableClickAni" Value="True"/>
					<Property Name="UnifiedAreaRect" Value="{{0,400},{0,108},{0,595},{0,172}}"/>
					<Property Name="AllowModalStateClick" Value="True"/>
				</Window>
				<Window Type="DefaultWindow" Name="address/di/xiala">
					<Property Name="Font" Value="simhei-12"/>
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="Visible" Value="False"/>
					<Property Name="EnableSound" Value="True"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="UnifiedAreaRect" Value="{{0,227},{0,172},{0,403},{0,378}}"/>
					<Property Name="AllowModalStateClick" Value="True"/>
					<Window Type="TaharezLook/ScrollablePane" Name="address/di/xiala/list">
						<Property Name="Font" Value="simhei-12"/>
						<Property Name="Scale" Value="x:1 y:1 z:1"/>
						<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
						<Property Name="EnableSound" Value="True"/>
						<Property Name="HorzStepSize" Value="0.1"/>
						<Property Name="LuaForDialog" Value="True"/>
						<Property Name="VertStepSize" Value="0.1"/>
						<Property Name="HorzOverlapSize" Value="0.01"/>
						<Property Name="UnifiedAreaRect" Value="{{0,7},{0,2},{0,168},{0,202}}"/>
