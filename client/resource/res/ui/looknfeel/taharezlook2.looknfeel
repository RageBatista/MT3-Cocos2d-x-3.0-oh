    <WidgetLook name="TaharezLook/TabButton">
		<PropertyDefinition name="NormalTextColour" initialValue="FFFFFFFF" redrawOnWrite="true" />
        <PropertyDefinition name="HoverTextColour" initialValue="tl:FF1AE7FF tr:FF1AE7FF bl:FF1AE7FF br:FF1AE7FF" redrawOnWrite="true" />
        <PropertyDefinition name="PushedTextColour" initialValue="tl:FF8C5E2A tr:FF8C5E2A bl:FF8C5E2A br:FF8C5E2A" redrawOnWrite="true" />
        <PropertyDefinition name="SelectedTextColour" initialValue="tl:FFFFFFFF tr:FFFFFFFF bl:FFFFFFFF br:FFFFFFFF" redrawOnWrite="true" />
        <PropertyDefinition name="DisabledTextColour" initialValue="tl:FF1AE7FF tr:FF1AE7FF bl:FF1AE7FF br:FF1AE7FF" redrawOnWrite="true" /> 
		<PropertyDefinition name="NormalBorderColour" initialValue="FF4b0400" redrawOnWrite="true" /> 
        <PropertyDefinition name="HoverBorderColour" initialValue="FF004093" redrawOnWrite="true" /> 
        <PropertyDefinition name="PushedBorderColour" initialValue="tl:FF8C5E2A tr:FF8C5E2A bl:FF8C5E2A br:FF8C5E2A" redrawOnWrite="true" /> 
