                <Image type="RightEdge" imageset="aalianyaosd" image="lysd_youzhong" /><!-- 右中-->
                <Image type="BottomEdge" imageset="aalianyaosd" image="lysd_dizhong" /><!-- 底中-->
                
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
                
