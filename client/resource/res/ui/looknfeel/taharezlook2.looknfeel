    <WidgetLook name="TaharezLook/MessageTip">
        <Property name="MousePassThroughEnabled" value="true" />
		<NamedArea name="TextArea">
            <Area>
                <Dim type="LeftEdge" ><ImageDim imageset="skillui" image="toumingkuang_lc" dimension="Width" /></Dim>
                <Dim type="TopEdge" ><ImageDim imageset="skillui" image="toumingkuang_ct" dimension="Height" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
            </Area>
        </NamedArea>
        <ImagerySection name="main">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image type="TopLeftCorner" imageset="skillui" image="toumingkuang_lt" />
                <Image type="TopRightCorner" imageset="skillui" image="toumingkuang_rt" />
                <Image type="BottomLeftCorner" imageset="skillui" image="toumingkuang_lb" />
                <Image type="BottomRightCorner" imageset="skillui" image="toumingkuang_rb" />
                <Image type="LeftEdge" imageset="skillui" image="toumingkuang_lc" />
                <Image type="RightEdge" imageset="skillui" image="toumingkuang_rc" />
                <Image type="TopEdge" imageset="skillui" image="toumingkuang_ct" />
                <Image type="BottomEdge" imageset="skillui" image="toumingkuang_cb" />
                <Image type="Background" imageset="skillui" image="toumingkuang_cc" />
            </FrameComponent>
        </ImagerySection>
         <Child  type="TaharezLook/RichEditbox" nameSuffix="__auto_richeditbox__">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1"  type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
            </Area>
            <VertAlignment type="BottomAligned" />
            <Property name="MousePassThroughEnabled" value="true" />
        </Child>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="main" />
            </Layer>
        </StateImagery>
        <StateImagery name="Disabled">
        </StateImagery>
    </WidgetLook>
