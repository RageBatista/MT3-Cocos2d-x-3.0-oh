    <!--
    ***************************************************
        TaharezLook/StaticShared
        (Shared imagery components for static widgets)
    ***************************************************
    -->
    <WidgetLook name="TaharezLook/StaticShared">
        <ImagerySection name="frame">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image type="TopLeftCorner" imageset="common" image="common_diban_lt" />
                <Image type="TopRightCorner" imageset="common" image="common_diban_rt" />
                <Image type="BottomLeftCorner" imageset="common" image="common_diban_lb" />
                <Image type="BottomRightCorner" imageset="common" image="common_diban_rb" />
                <Image type="LeftEdge" imageset="common" image="common_diban_lc" />
                <Image type="RightEdge" imageset="common" image="common_diban_rc" />
                <Image type="TopEdge" imageset="common" image="common_diban_ct" />
                <Image type="BottomEdge" imageset="common" image="common_diban_cb" />
                <Image type="Background" imageset="common" image="common_diban_cc" />
                <ColourRectProperty name="FrameColours" />
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />

            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="background">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><ImageDim imageset="common" image="common_diban_lc" dimension="Width" /></Dim>
