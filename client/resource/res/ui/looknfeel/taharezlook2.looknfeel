        TaharezLook/ListHeaderSegment
    ***************************************************
    -->
    <WidgetLook name="TaharezLook/ListHeaderSegment">
        <Property name="SizingCursorImage" value="set:jiangli image:zi" />
        <Property name="MovingCursorImage" value="set:jiangli image:zi" />
        <ImagerySection name="segment_normal">
            <Colours topLeft="ff5a3b1f" topRight="ff5a3b1f" bottomLeft="ff5a3b1f" bottomRight="ff5a3b1f" />
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="RightEdge" ><UnifiedDim scale="1" offset="0" type="RightEdge"/></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
				<Image type="LeftEdge" imageset="" image="" />
                <Image type="RightEdge" imageset="" image="" />
                <Image type="Background" imageset="" image="" />	
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="segment_hover">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="RightEdge" ><UnifiedDim scale="1" offset="0" type="RightEdge"/></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
				<Image type="LeftEdge" imageset="" image="" />
                <Image type="RightEdge" imageset="" image="" />
                <Image type="Background" imageset="" image="" />	
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="splitter_normal">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image imageset="jiangli" image="zi" />
                <VertFormat type="Stretched" />
                <HorzFormat type="RightAligned" />
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="splitter_hover">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image imageset="jiangli" image="zi" />
                <VertFormat type="Stretched" />
                <HorzFormat type="RightAligned" />
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="ascend_icon">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="3" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="3" /></Dim>
                    <Dim type="Width" ><ImageDim imageset="jiangli" image="zi" dimension="Width" /></Dim>
                    <Dim type="Height" ><ImageDim imageset="jiangli" image="zi" dimension="Height" /></Dim>
                </Area>
                <Image imageset="jiangli" image="zi" />
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="descend_icon">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="3" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="3" /></Dim>
                    <Dim type="Width" ><ImageDim imageset="TaharezLook" image="HeaderBarSortDown" dimension="Width" /></Dim>
                    <Dim type="Height" ><ImageDim imageset="TaharezLook" image="HeaderBarSortDown" dimension="Height" /></Dim>
                </Area>
                <Image imageset="jiangli" image="zi" />
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="label">
            <TextComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                       
                   
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="RightEdge" ><UnifiedDim scale="1" type="RightEdge" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <VertFormat type="CentreAligned" />
                <HorzFormat type="CentreAligned" />
            </TextComponent>
        </ImagerySection>
        <StateImagery name="Normal">
            <Layer>
                <Section section="segment_normal" />
                
                <Section section="label" >
                        <Colours topLeft="ff5a3b1f" topRight="ff5a3b1f" bottomLeft="ff5a3b1f" bottomRight="ff5a3b1f" />
                </Section>
            </Layer>
        </StateImagery>
        <StateImagery name="Hover">
            <Layer>
