        <PropertyDefinition name="EnableBottom" initialValue="0" redrawOnWrite="true" layoutOnWrite="true" />
		<PropertyDefinition name="EnableLeft" initialValue="0" redrawOnWrite="true" layoutOnWrite="true" />
