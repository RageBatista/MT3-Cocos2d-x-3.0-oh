<WidgetLook name="TaharezLook/common_textbg3">
        
       <ImagerySection name="normal">
			 <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                   
           	        <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                </Area>
                <Image type="TopLeftCorner" imageset="ccui4" image="1wqzhtu_tl" />
                <Image type="TopEdge" imageset="ccui4" image="1wqzhtu_tc" />
                <Image type="TopRightCorner" imageset="ccui4" image="1wqzhtu_tr" />
				
                <Image type="LeftEdge" imageset="ccui4" image="1wqzhtu_cl" />
                <Image type="Background" imageset="ccui4" image="1wqzhtu_cc" />
                <Image type="RightEdge" imageset="ccui4" image="1wqzhtu_cr" />
				
                <Image type="BottomLeftCorner" imageset="ccui4" image="1wqzhtu_dl" />
