                <Image type="TopLeftCorner" imageset="datiui" image="dibannewtl" />	<!--左上-->
                <Image type="TopEdge" imageset="datiui" image="dibannewtc" /> <!--顶中-->
                <Image type="TopRightCorner" imageset="datiui" image="dibannewtr" />	<!--右上-->
                <Image type="LeftEdge" imageset="datiui" image="dibannewcl" />  <!--中左-->
                <Image type="Background" imageset="datiui" image="dibannewcc" /><!--中中-->
                <Image type="RightEdge" imageset="datiui" image="dibannewcr" /><!--中右-->
                <Image type="BottomLeftCorner" imageset="datiui" image="dibannewdl" /> <!--左下-->
                <Image type="BottomEdge" imageset="datiui" image="dibannewdc" /><!--底中-->
                <Image type="BottomRightCorner" imageset="datiui" image="dibannewdr" /><!--右下-->
                
