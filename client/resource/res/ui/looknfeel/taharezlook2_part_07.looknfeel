                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" offset="0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" offset="0" type="Height" /></Dim>
                </Area>
                <Image type="LeftEdge" imageset="ccui1" image="tm" />
                <!--<Image type="RightEdge" imageset="common" image="common_xuetiaodi_r" />
                <Image type="Background" imageset="common" image="common_xuetiaodi_c" />-->
                <HorzFormat type="Tiled" />
                <VertFormat type="Stretched" />
				
				
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="label">
            <TextComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <VertFormat type="CentreAligned" />
                <HorzFormat type="CentreAligned" />
				<ColourProperty name="SelectedTextColour" />
            </TextComponent>
        </ImagerySection>
        <ImagerySection name="Green_lights" >
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" offset="0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" offset="0" type="Height" /></Dim>
                </Area>
                <Image type="LeftEdge" imageset="ccui1" image="tm" />
                <!--<Image type="RightEdge" imageset="common" image="common_green_r" />
                <Image type="Background" imageset="common" image="common_green_c" />-->
                <HorzFormat type="Tiled" />
                <VertFormat type="Stretched" />
				
            </FrameComponent>
        </ImagerySection>
        <StateImagery name="FrameBack">
            <Layer>
                <Section section="frame" />
<ColourProperty name="SelectedTextColour" />				
            </Layer>
        </StateImagery>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="Green_lights" />
				<ColourProperty name="SelectedTextColour" />
                
            </Layer>
        </StateImagery>
		<StateImagery name="EnabledColorfulProgress">
            <Layer>
                <Section section="Colorful_lights" />
				<ColourProperty name="SelectedTextColour" />
                
            </Layer>
        </StateImagery>
        <StateImagery name="LabelText">
            <Layer>   
                <Section section="label" />
				<ColourProperty name="SelectedTextColour" />
            </Layer>
        </StateImagery>
    </WidgetLook>
<WidgetLook name="TaharezLook/FrameWindowyl">
        <PropertyDefinition name="ClientAreaColour" initialValue="FF50321a" redrawOnWrite="true" />
        <PropertyLinkDefinition name="CaptionColour" widget="__auto_titlebar__" targetProperty="CaptionColour" initialValue="FFFFFFFF" />
         <!--
         <PropertyLinkDefinition name="TitlebarFont" widget="__auto_titlebar__" targetProperty="Font" />
          -->
        
        <Property name="UnifiedMinSize" value="{{0.1,0},{0.1,0}}" />
        
        <NamedArea name="ClientWithTitleWithFrame">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="0"  /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="ClientWithTitleNoFrame">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><WidgetDim widget="__auto_titlebar__" dimension="BottomEdge" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="BottomEdge" ><WidgetDim dimension="BottomEdge" /></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="ClientNoTitleWithFrame">
            <Area>
                <Dim type="LeftEdge" ><ImageDim imageset="common_bgcase" image="commonbg4" dimension="Width" /></Dim>
                <Dim type="TopEdge" ><ImageDim imageset="common_bgcase" image="commonbg2" dimension="Height" /></Dim>
                <Dim type="RightEdge" >
                    <UnifiedDim scale="1" type="RightEdge">
                        <DimOperator op="Subtract">
                            <ImageDim imageset="common_bgcase" image="commonbg6" dimension="Width" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
                <Dim type="BottomEdge" >
                    <UnifiedDim scale="1" type="BottomEdge">
                        <DimOperator op="Subtract">
                            <ImageDim imageset="common_bgcase" image="commonbg8" dimension="Height" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
            </Area>                                                                                                                                                                                                     
        </NamedArea>
        <NamedArea name="ClientNoTitleNoFrame">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
            </Area>
        </NamedArea>
        <Child type="TaharezLook/Titlebar" nameSuffix="__auto_titlebar__">
            <Area>
                
                 <Dim type="LeftEdge" ><UnifiedDim scale="0" offset="50" type="LeftEdge" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="17" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" offset="-100" type="Width" /></Dim>
                <Dim type="Height" ><AbsoluteDim value="30" /></Dim>
           
            </Area>
            <Property name="AlwaysOnTop" value="True" />
            <Property name="Visible" value="False" />
        </Child>
        <Child type="TaharezLook/ImageButton" nameSuffix="__auto_closebutton__">
            <Area>
                <Dim type="LeftEdge" >
                    <UnifiedDim scale="1" type="RightEdge">
                        <DimOperator op="Subtract">
                           <AbsoluteDim value="93"/> 
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
                <Dim type="TopEdge" > <AbsoluteDim value="-16"/></Dim>
                       
                    
                
                <Dim type="Width" ><ImageDim imageset="cc2549" image="cxxx" dimension="Width" /></Dim>
                <Dim type="Height" ><ImageDim imageset="cc2549" image="cxxx" dimension="Height" /></Dim>
            </Area>
            <Property name="AlwaysOnTop" value="True" />
			<Property name="ClippedByParent" value="False" />
            <Property name="NormalImage" value="set:cc2549 image:cxxx" />
            <Property name="HoverImage" value="set:cc2549 image:cxxx" />
            <Property name="PushedImage" value="set:cc2549 image:cxxx" />
            
        </Child>
