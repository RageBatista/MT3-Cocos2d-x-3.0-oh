                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image type="TopLeftCorner" imageset="jiangli" image="zi" />
                <Image type="TopRightCorner" imageset="jiangli" image="zi" />
                <Image type="BottomLeftCorner" imageset="jiangli" image="zi" />
                <Image type="BottomRightCorner" imageset="jiangli" image="zi" />
                <Image type="LeftEdge" imageset="jiangli" image="zi" />
                <Image type="RightEdge" imageset="jiangli" image="zi" />
                <Image type="TopEdge" imageset="jiangli" image="zi" />
                <Image type="BottomEdge" imageset="jiangli" image="zi" />
