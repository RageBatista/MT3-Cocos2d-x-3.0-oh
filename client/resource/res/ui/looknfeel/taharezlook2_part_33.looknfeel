<?xml version="1.0" ?>
<Falagard>
<WidgetLook name="TaharezLook/ActiveCellGroupButton">

		<PropertyDefinition name="NormalTextColour" initialValue="tl:FF582A07 tr:FF582A07 bl:FF582A07 br:FF582A07" redrawOnWrite="true" />
