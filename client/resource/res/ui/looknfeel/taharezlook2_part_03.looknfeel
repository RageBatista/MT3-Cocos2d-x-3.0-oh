<WidgetLook name="TaharezLook/Switch">
        <ImagerySection name="on">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="19" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" offset="-28" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" offset="-10" type="Height" /></Dim>
                </Area>
				<Image type="LeftEdge" imageset="ccui" image="lvsecc_l" />
                <Image type="RightEdge" imageset="ccui" image="lvsecc_r" />
                <Image type="Background" imageset="ccui" image="lvsecc_c" />
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="off">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="19" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" offset="-28" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" offset="-10" type="Height" /></Dim>
                </Area>
				<Image type="LeftEdge" imageset="ccui" image="xtdzcc_l" />
                <Image type="RightEdge" imageset="ccui" image="xtdzcc_r" />
                <Image type="Background" imageset="ccui" image="xtdzcc_c" />
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
		<Child type="TaharezLook/StaticImage" nameSuffix="__auto_thumb__">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0"/></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="-6"/></Dim>
                <Dim type="Width"><UnifiedDim scale="1" type="Height" /></Dim>
                <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
            </Area>
            <Property name="AlwaysOnTop" value="True" />
            <Property name="Image" value="set:ccui1 image:zongseyuan" />
        </Child>
        <StateImagery name="ONNormal">
            <Layer>
                <Section section="off" />
                <Section section="on" />
            </Layer>
        </StateImagery>
        <StateImagery name="ONPushed">
            <Layer>
                <Section section="off" />
                <Section section="on" />
            </Layer>
        </StateImagery>
	<StateImagery name="ONHover">
            <Layer>
                <Section section="off" />
                <Section section="on" />
            </Layer>
        </StateImagery>
        <StateImagery name="ONDisabled">
            <Layer>
                <Section section="off" />
                <Section section="on" />
            </Layer>
        </StateImagery>
        <StateImagery name="OFFNormal">
            <Layer>
                <Section section="off" />
            </Layer>
        </StateImagery>
        <StateImagery name="OFFPushed">
            <Layer>
                <Section section="off" />
            </Layer>
        </StateImagery>
	<StateImagery name="OFFHover">
            <Layer>
                <Section section="off" />
            </Layer>
        </StateImagery>
        <StateImagery name="OFFDisabled">
            <Layer>
                <Section section="off" />
            </Layer>
        </StateImagery>
    </WidgetLook>
<WidgetLook name="TaharezLook/common_bgcase">
        <NamedArea name="TextArea">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="10" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="6" /></Dim>
                <Dim type="RightEdge" >
                    <UnifiedDim scale="1" type="RightEdge">
                        <DimOperator op="Subtract">
                            <AbsoluteDim value="10" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
                <Dim type="BottomEdge" >
                    <UnifiedDim scale="1" type="BottomEdge">
                        <DimOperator op="Subtract">
                            <AbsoluteDim value="6" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
            </Area>
        </NamedArea>
        <ImagerySection name="main">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image type="TopLeftCorner" imageset="huodong" image="hongdongbai_lt" />
                <Image type="TopRightCorner" imageset="huodong" image="hongdongbai_rt" />
                <Image type="BottomLeftCorner" imageset="huodong" image="hongdongbai_lb" />
                <Image type="BottomRightCorner" imageset="huodong" image="hongdongbai_rb" />
                <Image type="LeftEdge" imageset="huodong" image="hongdongbai_lc" />
                <Image type="RightEdge" imageset="huodong" image="hongdongbai_rc" />
                <Image type="TopEdge" imageset="huodong" image="hongdongbai_ct" />
                <Image type="BottomEdge" imageset="huodong" image="hongdongbai_cb" />
                <Image type="Background" imageset="huodong" image="hongdongbai_cc" />
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="label">
            <TextComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="10" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="6" /></Dim>
                    <Dim type="RightEdge" >
                        <UnifiedDim scale="1" type="RightEdge">
                            <DimOperator op="Subtract">
                                <AbsoluteDim value="10" />
                            </DimOperator>
                        </UnifiedDim>
                    </Dim>
                    <Dim type="BottomEdge" >
                        <UnifiedDim scale="1" type="BottomEdge">
                            <DimOperator op="Subtract">
                                <AbsoluteDim value="6" />
                            </DimOperator>
                        </UnifiedDim>
                    </Dim>
                </Area>
                <Colours topLeft="FFFFFFFF" topRight="FFFFFFFF" bottomLeft="FFFFFFFF" bottomRight="FFFFFFFF" />
                <VertFormat type="CentreAligned" />
                <HorzFormat type="LeftAligned" />
            </TextComponent>
        </ImagerySection>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="main" />
                <Section section="label" />
            </Layer>
        </StateImagery>
        <StateImagery name="Disabled">
            <Layer>
                <Section section="main" />
                <Section section="label" />
            </Layer>
        </StateImagery>
    </WidgetLook>
<WidgetLook name="TaharezLook/BattleProgressBar">
         <NamedArea name="ProgressAreaFrameEnable">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" offset="0" type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" offset="0" type="Height" /></Dim>
            </Area>
        </NamedArea>
	    <NamedArea name="ProgressAreaFrameDisable">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1"  type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1"  type="Height" /></Dim>
            </Area>
        </NamedArea>
        <ImagerySection name="frame">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="-3" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="-3" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" offset="6" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" offset="6" type="Height" /></Dim>
                </Area>
                <Image type="LeftEdge" imageset="fightui" image="zhandouxuetiaodi_l" />
                <Image type="RightEdge" imageset="fightui" image="zhandouxuetiaodi_r" />
                <Image type="Background" imageset="fightui" image="zhandouxuetiaodi_c" />
                <HorzFormat type="Tiled" />
                <VertFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="label">
            <TextComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <VertFormat type="CentreAligned" />
                <HorzFormat type="CentreAligned" />
            </TextComponent>
        </ImagerySection>
        <ImagerySection name="Red_lights_Enable_WithFrame" >
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" offset="0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" offset="0" type="Height" /></Dim>
                </Area>
                <Image type="LeftEdge" imageset="fightui" image="zhandouxuetiao_l" />
                <Image type="RightEdge" imageset="fightui" image="zhandouxuetiao_r" />
                <Image type="Background" imageset="fightui" image="zhandouxuetiao_c" />
                <HorzFormat type="Tiled" />
                <VertFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
		
		 <ImagerySection name="White_lights_WithFrame" >
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" offset="0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" offset="0" type="Height" /></Dim>
                </Area>
                <HorzFormat type="Tiled" />
                <VertFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
		         <ImagerySection name="EnabledRedProgress_WithFrame" >
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <HorzFormat type="Tiled" />
                <VertFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
		
        <StateImagery name="Frame">
            <Layer>
                <Section section="frame" />  
            </Layer>
        </StateImagery>
		 <StateImagery name="EnabledRedProgress_WithFrame">
            <Layer>   
                <Section section="Red_lights_Enable_WithFrame" />
                
            </Layer>
        </StateImagery>
        
        <StateImagery name="EnabledRedProgress_NoFrame">
            <Layer> 
                <Section section="Red_lights_Enable_WithFrame" />    
            </Layer>
        </StateImagery>
         
   			  <StateImagery name="DisabledRedProgress">
            <Layer>
                 
                <Section section="EnabledRedProgress_WithFrame">
                    <Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" />
                </Section>
                
            </Layer>
        </StateImagery>
         <StateImagery name="EnabledWhiteProgress">
            <Layer>        
                <Section section="White_lights_WithFrame" />             
            </Layer>
        </StateImagery>
         <StateImagery name="EnabledWhiteProgress_NoFrame">
            <Layer>
                <Section section="White_lights_WithFrame" />
          
            </Layer>
        </StateImagery>
		<StateImagery name="EnabledColorfulProgress">
            <Layer>
                <Section section="Colorful_lights" />
                
            </Layer>
        </StateImagery>
        <StateImagery name="LabelText">
            <Layer>   
                <Section section="label" />
            </Layer>
        </StateImagery>
    </WidgetLook>
</Falagard>
