                 <Dim type="TopEdge" ><AbsoluteDim value="20" /></Dim>
                 <Dim type="Width" ><UnifiedDim scale="1" offset="-40" type="Width" /></Dim>
                 <Dim type="Height" ><UnifiedDim scale="1" offset="-20" type="Height" /></Dim>
