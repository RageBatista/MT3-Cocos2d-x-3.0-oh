<?xml version="1.0" ?>
<Falagard>
<WidgetLook name="TaharezLook/ItemCell_bai">

        
         <PropertyDefinition name="NormalTextColour" initialValue="FFFFFFFF" redrawOnWrite="true" />
        
        <PropertyDefinition name="VertLabelFormatting" initialValue="CentreAligned" />
        <PropertyDefinition name="HorzLabelFormatting" initialValue="CentreAligned" />
         <NamedArea name="ItemCellRenderingArea">
            <Area>
                 <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                 <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                 <Dim type="Width" ><UnifiedDim scale="1" offset="0" type="Width" /></Dim>
                 <Dim type="Height" ><UnifiedDim scale="1" offset="0" type="Height" /></Dim>
            </Area>
        </NamedArea>
        
        <ImagerySection name="label">
            <TextComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <VertFormatProperty name="VertLabelFormatting" />
                <HorzFormatProperty name="HorzLabelFormatting" />
                <ColourProperty name="NormalTextColour" />
                
            </TextComponent>
        </ImagerySection>
        <ImagerySection name="Enable">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1.0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1.0" type="Height" /></Dim>
                </Area>
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
         <ImagerySection name="ItemInCell">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1.0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1.0" type="Height" /></Dim>
                </Area>
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="MouseOn">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1.0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1.0" type="Height" /></Dim>
                </Area>
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </ImageryComponent>
        </ImagerySection>
        
        <ImagerySection name="Selected">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1.0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1.0" type="Height" /></Dim>
                </Area>
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </FrameComponent>
        </ImagerySection>
        
        <ImagerySection name="SelectedMouseOn">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1.0" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1.0" type="Height" /></Dim>
                </Area>
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="BackGroundDisable">
            <Layer>
                
            </Layer>
        </StateImagery>
       
        <StateImagery name="Disabled">
            <Layer>
                <Section section="Enable" />
                <Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" />
            </Layer>
        </StateImagery>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="Enable" />
                <Section section="label" />
            </Layer>
        </StateImagery>
		<StateImagery name="ItemInCell">
            <Layer>
                <Section section="ItemInCell" />
                <Section section="label" />
            </Layer>
        </StateImagery>  		
        <StateImagery name="MouseOnEnabled">
            <Layer>
                <Section section="MouseOn" />
            </Layer>
        </StateImagery>
        <StateImagery name="SelectedEnabled">
            <Layer>
                <Section section="Selected" />
            </Layer>
        </StateImagery>
        <StateImagery name="SelectedMouseEnabled">
            <Layer>
                <Section section="SelectedMouseOn" />
            </Layer>
        </StateImagery>
		<StateImagery name="WithBackGround">
            <Layer>
            </Layer>
   </StateImagery>
		<StateImagery name="MouseOnBackGround">
            <Layer>
                <Section section="MouseOn" />
            </Layer>
        </StateImagery>
        <StateImagery name="SelectedBackGround">
            <Layer>
                <Section section="Selected" />
            </Layer>
        </StateImagery>
        <StateImagery name="SelectedMouseBackGround">
            <Layer>
                <Section section="SelectedMouseOn" />
            </Layer>
        </StateImagery>
    </WidgetLook>
