        <Child  type="TaharezLook/ListHeader" nameSuffix="__auto_listheader__">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="3" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="2" /></Dim>
