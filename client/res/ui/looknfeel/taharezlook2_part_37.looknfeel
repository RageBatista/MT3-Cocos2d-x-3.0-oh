<?xml version="1.0" ?>
<Falagard>
<WidgetLook name="TaharezLook/CBG_TOPDI">
 
       <ImagerySection name="normal">
			 <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                   
           	        <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                </Area>
                <Image type="LeftEdge" imageset="cbg" image="top_left" />
               <Image type="RightEdge" imageset="cbg" image="top_rright" />
                <Image type="Background" imageset="cbg" image="top_center" />
                
            </FrameComponent>
        </ImagerySection>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="normal" />
            </Layer>
        </StateImagery>
        <StateImagery name="Disabled">
            <Layer>
                <Section section="normal">
                    <Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" />
                </Section>
            </Layer>
        </StateImagery>
    </WidgetLook>
<WidgetLook name="TaharezLook/CBG_BAI">
 
       <ImagerySection name="normal">
			 <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                   
           	        <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                </Area>
                 <Image type="LeftEdge" imageset="cbg" image="bai_l" />
                <Image type="RightEdge" imageset="cbg" image="bai_r" />
                <Image type="Background" imageset="cbg" image="bai_c" />
                
            </FrameComponent>
        </ImagerySection>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="normal" />
            </Layer>
        </StateImagery>
        <StateImagery name="Disabled">
