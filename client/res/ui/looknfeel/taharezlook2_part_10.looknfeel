                <Dim type="Height" ><AbsoluteDim value="30" /></Dim>
           
            </Area>
            <Property name="AlwaysOnTop" value="True" />
            <Property name="Visible" value="False" />
        </Child>
        <Child type="TaharezLook/ImageButton" nameSuffix="__auto_closebutton__">
            <Area>
                <Dim type="LeftEdge" >
                    <UnifiedDim scale="1" type="RightEdge">
                        <DimOperator op="Subtract">
                           <AbsoluteDim value="130"/> 
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
                <Dim type="TopEdge" > <AbsoluteDim value="-2"/></Dim>
                       
                    
                
                <Dim type="Width" ><ImageDim imageset="ccui" image="common_X" dimension="Width" /></Dim>
                <Dim type="Height" ><ImageDim imageset="ccui" image="common_X" dimension="Height" /></Dim>
            </Area>
            <Property name="AlwaysOnTop" value="True" />
			<Property name="ClippedByParent" value="False" />
            <Property name="NormalImage" value="set:ccui image:common_X" />
            <Property name="HoverImage" value="set:ccui image:common_X" />
            <Property name="PushedImage" value="set:ccui image:common_X" />
            
        </Child>
