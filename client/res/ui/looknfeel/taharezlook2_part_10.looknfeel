                    </UnifiedDim>
                </Dim>
                <Dim type="TopEdge" > <AbsoluteDim value="0"/></Dim>
                       
                    
                
                <Dim type="Width" ><ImageDim imageset="cc2546" image="cxxx" dimension="Width" /></Dim>
                <Dim type="Height" ><ImageDim imageset="cc2546" image="cxxx" dimension="Height" /></Dim>
            </Area>
            <Property name="AlwaysOnTop" value="True" />
			<Property name="ClippedByParent" value="False" />
