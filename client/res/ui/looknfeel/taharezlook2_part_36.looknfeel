<?xml version="1.0" ?>
<Falagard>
<WidgetLook name="TaharezLook/POPORichEditbox6">

        <PropertyDefinition name="NormalTextColour" initialValue="FFEB5972" redrawOnWrite="true" />
        <PropertyDefinition name="SelectedTextColour" initialValue="FF000000" redrawOnWrite="true" />
        <PropertyDefinition name="ActiveSelectionColour" initialValue="FF607FFF" redrawOnWrite="true" />
        <PropertyDefinition name="InactiveSelectionColour" initialValue="FF808080" redrawOnWrite="true" />
       
        <NamedArea name="TextArea">
            <Area>
              <Dim type="LeftEdge" ><AbsoluteDim value="20" /></Dim>
                 <Dim type="TopEdge" ><AbsoluteDim value="15" /></Dim>
                 <Dim type="Width" ><UnifiedDim scale="1" offset="-40" type="Width" /></Dim>
                 <Dim type="Height" ><UnifiedDim scale="1" offset="-20" type="Height" /></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="TextAreaHScroll">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="3" /></Dim>
                 <Dim type="TopEdge" ><AbsoluteDim value="3" /></Dim>
               <Dim type="Width" ><UnifiedDim scale="1" offset="-6" type="Width" /></Dim>
                <Dim type="BottomEdge" >
                    <UnifiedDim scale="1" type="BottomEdge">
                        <DimOperator op="Subtract">
                            <WidgetDim widget="__auto_hscrollbar__" dimension="Height" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
            </Area>
        </NamedArea>
        <NamedArea name="TextAreaVScroll">
            <Area>
                 <Dim type="LeftEdge" ><AbsoluteDim value="3" /></Dim>
                 <Dim type="TopEdge" ><AbsoluteDim value="3" /></Dim>
                <Dim type="RightEdge" >
                    <UnifiedDim scale="1" offset="-1" type="RightEdge">
                        <DimOperator op="Subtract">
                            <WidgetDim widget="__auto_vscrollbar__" dimension="Width" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
               <Dim type="Height" ><UnifiedDim scale="1" offset="-6" type="Height" /></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="TextAreaHVScroll">
            <Area>
                  <Dim type="LeftEdge" ><AbsoluteDim value="3" /></Dim>
                 <Dim type="TopEdge" ><AbsoluteDim value="3" /></Dim>
                <Dim type="RightEdge" >
                    <UnifiedDim scale="1" type="RightEdge">
                        <DimOperator op="Subtract">
                            <WidgetDim widget="__auto_vscrollbar__" dimension="Width" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
                <Dim type="BottomEdge" >
                    <UnifiedDim scale="1" type="BottomEdge">
                        <DimOperator op="Subtract">
                            <WidgetDim widget="__auto_hscrollbar__" dimension="Height" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
            </Area>
        </NamedArea>
        <Child  type="TaharezLook/HorizontalScrollbar" nameSuffix="__auto_hscrollbar__">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" offset="-1" type="Width" /></Dim>
                <Dim type="Height" ><AbsoluteDim value="18" /></Dim>
            </Area>
            <VertAlignment type="BottomAligned" />
        </Child>
        <Child  type="TaharezLook/VerticalScrollbar" nameSuffix="__auto_vscrollbar__">
            <Area>
                <Dim type="LeftEdge" ><UnifiedDim scale="1" offset="-21" type="Width"  /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="2" /></Dim>
                <Dim type="Width" ><AbsoluteDim value="18" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" offset="-6" type="Height" /></Dim>
            </Area>
           
        </Child>
        <ImagerySection name="main">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image type="TopLeftCorner" imageset="awaiguanyichu" image="mpk6_zuoshang" />   <!-- 左上-->
                <Image type="TopRightCorner" imageset="awaiguanyichu" image="mpk6_youshang" />  <!-- 右上-->
                <Image type="BottomLeftCorner" imageset="awaiguanyichu" image="mpk6_zuoxia" /> <!-- 左下-->
                <Image type="BottomRightCorner" imageset="awaiguanyichu" image="mpk6_youxia" /><!-- 右下-->
				<Image type="TopEdge" imageset="awaiguanyichu" image="mpk6_dingzhong" /><!-- 中顶-->
                <Image type="Background" imageset="awaiguanyichu" image="mpk6_zhong" /><!-- 中-->
                <Image type="LeftEdge" imageset="awaiguanyichu" image="mpk6_zuozhong" /><!-- 左中-->
                <Image type="RightEdge" imageset="awaiguanyichu" image="mpk6_youzhong" /><!-- 右中-->
                <Image type="BottomEdge" imageset="awaiguanyichu" image="mpk6_dizhong" /><!-- 底中-->
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="Carat">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><AbsoluteDim value="1" /></Dim>
                    <Dim type="BottomEdge" ><UnifiedDim scale="1.0" type="BottomEdge" /></Dim>
                </Area>
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="main" />
            </Layer>
        </StateImagery>
        <StateImagery name="ReadOnly">
            <Layer>
                <Section section="main" />
            </Layer>
        </StateImagery>
        <StateImagery name="Disabled">
            <Layer>
                <Section section="main">
                    <Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" />
                </Section>
            </Layer>
        </StateImagery>
    </WidgetLook>
