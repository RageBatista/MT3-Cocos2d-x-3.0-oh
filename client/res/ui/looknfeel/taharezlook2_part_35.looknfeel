<?xml version="1.0" ?>
<Falagard>
<WidgetLook name="TaharezLook/FrameWindowhechongjieguo">

        <PropertyDefinition name="ClientAreaColour" initialValue="FFFFFFFF" redrawOnWrite="true" />
        <PropertyLinkDefinition name="CaptionColour" widget="__auto_titlebar__" targetProperty="CaptionColour" initialValue="FFFFFFFF" />
         <!--
         <PropertyLinkDefinition name="TitlebarFont" widget="__auto_titlebar__" targetProperty="Font" />
          -->
        
        <Property name="UnifiedMinSize" value="{{0.1,0},{0.1,0}}" />
        
        <NamedArea name="ClientWithTitleWithFrame">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="0"  /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="ClientWithTitleNoFrame">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><WidgetDim widget="__auto_titlebar__" dimension="BottomEdge" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="BottomEdge" ><WidgetDim dimension="BottomEdge" /></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="ClientNoTitleWithFrame">
            <Area>
                <Dim type="LeftEdge" ><ImageDim imageset="common_bgcase" image="commonbg4" dimension="Width" /></Dim>
                <Dim type="TopEdge" ><ImageDim imageset="common_bgcase" image="commonbg2" dimension="Height" /></Dim>
                <Dim type="RightEdge" >
                    <UnifiedDim scale="1" type="RightEdge">
                        <DimOperator op="Subtract">
                            <ImageDim imageset="common_bgcase" image="commonbg6" dimension="Width" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
                <Dim type="BottomEdge" >
                    <UnifiedDim scale="1" type="BottomEdge">
                        <DimOperator op="Subtract">
                            <ImageDim imageset="common_bgcase" image="commonbg8" dimension="Height" />
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
            </Area>                                                                                                                                                                                                     
        </NamedArea>
        <NamedArea name="ClientNoTitleNoFrame">
            <Area>
                <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
            </Area>
        </NamedArea>
        <Child type="TaharezLook/Titlebar" nameSuffix="__auto_titlebar__">
            <Area>
                
                 <Dim type="LeftEdge" ><UnifiedDim scale="0" offset="55" type="LeftEdge" /></Dim>
                <Dim type="TopEdge" ><AbsoluteDim value="62" /></Dim>
                <Dim type="Width" ><UnifiedDim scale="1" offset="-100" type="Width" /></Dim>
                <Dim type="Height" ><AbsoluteDim value="30" /></Dim>
           
            </Area>
            <Property name="AlwaysOnTop" value="True" />
            <Property name="Visible" value="False" />
        </Child>
        <Child type="TaharezLook/ImageButton" nameSuffix="__auto_closebutton__">
            <Area>
                <Dim type="LeftEdge" >
                    <UnifiedDim scale="1" type="RightEdge">
                        <DimOperator op="Subtract">
                           <AbsoluteDim value="114"/> 
                        </DimOperator>
                    </UnifiedDim>
                </Dim>
                <Dim type="TopEdge" > <AbsoluteDim value="14"/></Dim>
				
                <Dim type="Width" ><ImageDim imageset="common" image="common_X" dimension="Width" /></Dim>
                <Dim type="Height" ><ImageDim imageset="common" image="common_X" dimension="Height" /></Dim>
            </Area>
            <Property name="AlwaysOnTop" value="True" />
			<Property name="ClippedByParent" value="False" />
            <Property name="NormalImage" value="set:common image:common_X" />
            <Property name="HoverImage" value="set:common image:common_X" />
            <Property name="PushedImage" value="set:common image:common_X" />
            
        </Child>
     <ImagerySection name="withtitle_frame">
             
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                
				<!-- <Image type="TopLeftCorner" imageset="logindlginfo" image="loginbg_tl" /> -->
				<!-- <Image type="TopEdge" imageset="logindlginfo" image="loginbg_tc" /> -->
                <!-- <Image type="TopRightCorner" imageset="logindlginfo" image="loginbg_tr" /> -->
                <!-- <Image type="LeftEdge" imageset="logindlginfo" image="loginbg_cl" /> -->
                <!-- <Image type="Background" imageset="logindlginfo" image="loginbg_cc" /> -->
                <!-- <Image type="RightEdge" imageset="logindlginfo" image="loginbg_cr" /> -->
                <!-- <Image type="BottomLeftCorner" imageset="logindlginfo" image="loginbg_bl" /> -->
                <!-- <Image type="BottomEdge" imageset="logindlginfo" image="loginbg_bc" /> -->
                <!-- <Image type="BottomRightCorner" imageset="logindlginfo" image="loginbg_br" /> -->
				
				
				
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
                
            </FrameComponent>
			
		    <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="2" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="-1" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" offset="-4" type="Width" /></Dim>
                <Dim type="Height" ><UnifiedDim scale="1" offset="1" type="Height" /></Dim>
                </Area>

                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
                
            </FrameComponent>	
			           
       
        </ImagerySection>
        <ImagerySection name="notitle_frame">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image type="TopLeftCorner" imageset="common_bgcase" image="commonbg1" />
                <Image type="TopRightCorner" imageset="common_bgcase" image="commonbg3" />
                <Image type="BottomLeftCorner" imageset="common_bgcase" image="commonbg7" />
                <Image type="BottomRightCorner" imageset="common_bgcase" image="commonbg9" />
				<Image type="TopEdge" imageset="common_bgcase" image="commonbg2" />
                <Image type="Background" imageset="common_bgcase" image="commonbg5" />
                <Image type="LeftEdge" imageset="common_bgcase" image="commonbg4" />
                <Image type="RightEdge" imageset="common_bgcase" image="commonbg6" />
                <Image type="BottomEdge" imageset="common_bgcase" image="commonbg8" />
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="withtitle_noframe_client_area">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><WidgetDim widget="__auto_titlebar__" dimension="Height" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="BottomEdge" ><UnifiedDim scale="1" type="BottomEdge" /></Dim>
                </Area>
                <ColourProperty name="ClientAreaColour" />
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="notitle_noframe_client_area">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge" ><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width" ><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height" ><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <ColourProperty name="ClientAreaColour" />
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="ActiveWithTitleWithFrame">
            <Layer>
                <Section section="withtitle_frame" />
            </Layer>
        </StateImagery>
        <StateImagery name="InactiveWithTitleWithFrame">
            <Layer>
                <Section section="withtitle_frame" />
            </Layer>
        </StateImagery>
        <StateImagery name="DisabledWithTitleWithFrame">
            <Layer>
                <Section section="withtitle_frame">
                    <Colours topLeft="ffffffff" topRight="ffffffff" bottomLeft="ffffffff" bottomRight="ffffffff" />
                </Section>
            </Layer>
        </StateImagery>
        <StateImagery name="ActiveWithTitleNoFrame">
