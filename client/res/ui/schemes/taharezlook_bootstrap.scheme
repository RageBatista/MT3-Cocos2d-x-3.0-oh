<?xml version="1.0" encoding="UTF-8" ?>
<GUIScheme Name="TaharezLookBootstrap">
    <Imageset Filename="ccui.imageset" />
    <Imageset Filename="ccui1.imageset" />
    <Imageset Filename="common.imageset" />
    <Imageset Filename="jiangli.imageset" />
    <Imageset Filename="renwuui.imageset" />

    <Font Filename="simhei-10.font" />
    <Font Filename="simhei-11.font" />
    <Font Filename="simhei-12.font" />
    <Font Filename="simhei-16.font" />
    <Font Filename="simhei-18.font" />
    <Font Filename="mhsy-10-normal.font" />
    <Font Filename="mhsy-13-normal.font" />

    <LookNFeel Filename="taharezlook_bootstrap.looknfeel" />
    <WindowRendererSet Filename="CEGUIFalagardWRBase" />

    <FalagardMapping WindowType="TaharezLook/Button" TargetType="CEGUI/PushButton" Renderer="Falagard/Button" LookNFeel="TaharezLook/Button" />
    <FalagardMapping WindowType="TaharezLook/Tooltip" TargetType="CEGUI/Tooltip" Renderer="Falagard/Tooltip" LookNFeel="TaharezLook/Tooltip1" />
    <FalagardMapping WindowType="TaharezLook/StaticImage" TargetType="DefaultWindow" Renderer="Falagard/StaticImage" LookNFeel="TaharezLook/StaticImage" />
    <FalagardMapping WindowType="TaharezLook/StaticText" TargetType="DefaultWindow" Renderer="Falagard/StaticText" LookNFeel="TaharezLook/StaticText" />
    <FalagardMapping WindowType="TaharezLook/CompnentTip" TargetType="CEGUI/MessageTip" Renderer="Falagard/Default" LookNFeel="TaharezLook/Tooltip1" />
    <FalagardMapping WindowType="TaharezLook/ImageButton" TargetType="CEGUI/PushButton" Renderer="Falagard/Button" LookNFeel="TaharezLook/ImageButton" />
</GUIScheme>
