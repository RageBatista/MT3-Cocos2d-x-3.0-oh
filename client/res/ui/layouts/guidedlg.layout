<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticImage" Name="guidedlg">
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-272},{0.523944,0},{0.5,-47},{0.645038,-10}}"/>
		<Property Name="MousePassThroughEnabled" Value="True"/>
		<Window Type="TaharezLook/zhiyin1" Name="guidedlg/image/textback">
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="ClippedByParent" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,260},{0,75}}"/>
			<Window Type="TaharezLook/RichEditbox" Name="guidedlg/text">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="ReadOnly" Value="True"/>
				<Property Name="LineSpace" Value="1.0"/>
				<Property Name="BlinkCaret" Value="True"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="MaxTextLength" Value="10"/>
				<Property Name="UnifiedAreaRect" Value="{{0.05,-0.55},{0.05,8.95},{0.05,209.351},{0.05,56.95}}"/>
				<Property Name="BlinkCaretTimeout" Value="0.5"/>
				<Property Name="TextParsingEnabled" Value="False"/>
			</Window>
		</Window>
	</Window>
</GUILayout>
