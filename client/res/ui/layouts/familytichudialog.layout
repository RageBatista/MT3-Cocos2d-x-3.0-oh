<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/FrameWindow3" Name="familytichudialog">
		<Property Name="Font" Value="hycyj-20"/>
		<Property Name="Text" Value="帮派逐出"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="Familytichudialog"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="RollUpEnabled" Value="True"/>
		<Property Name="SizingEnabled" Value="False"/>
		<Property Name="LimitWindowSize" Value="False"/>
		<Property Name="TitlebarEnabled" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-331},{0.5,-274},{0.5,331},{0.5,274}}"/>
		<Property Name="DragMovingEnabled" Value="False"/>
		<Property Name="HorizontalAlignment" Value="Centre"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/StaticText" Name="familytichudialog/tishi">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="确定要将XXX逐出帮派？"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="273.0"/>
			<Property Name="VertExtent" Value="25.6593"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FF000000 tr:FF000000 bl:FF000000 br:FF000000"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="LuaMemberName" Value="m_TitleText"/>
			<Property Name="HorzFormatting" Value="HorzCentred"/>
			<Property Name="UnifiedAreaRect" Value="{{0,50},{0,100},{0,663},{0,143}}"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/dangebutton" Name="familytichudialog/OK">
