<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="TaharezLook/CellGroupButtonFxkuang" Name="zuoqitycell2" >
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Scale" Value="x:1 y:1 z:1" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="LuaForDialog" Value="True" />
        <Property Name="EnableClickAni" Value="False" />
        <Property Name="UnifiedAreaRect" Value="{{0,31},{0,31},{0,131},{0,127}}" />
        <Window Type="TaharezLook/ItemCell" Name="zuoqitycell2/touxiang" >
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="UnifiedAreaRect" Value="{{0,6},{0,5},{0,95},{0,88}}" />
            <Property Name="MousePassThroughEnabled" Value="True" />
            <Window Type="TaharezLook/StaticImage" Name="zuoqitycell2/touxiang/jiahao" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Image" Value="set:huobanui image:huoban_jiahao" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="Visible" Value="False" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,6},{0,3},{0,83},{0,79}}" />
                <Property Name="MousePassThroughEnabled" Value="True" />
            </Window>
        </Window>
    </Window>
</GUILayout>
