				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,80},{0,334},{0,760},{0,640}}"/>
				<Property Name="AllowModalStateClick" Value="True"/>
				<Window Type="TaharezLook/RichEditbox" Name="tanhe/ditu/textbg/text">
