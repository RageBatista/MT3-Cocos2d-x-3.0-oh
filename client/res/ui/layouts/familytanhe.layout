<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="tanhe">
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Window Type="TaharezLook/FrameWindow2" Name="tanhe/ditu">
			<Property Name="Font" Value="hycyj-20"/>
			<Property Name="Text" Value="弹劾会长"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="RollUpEnabled" Value="True"/>
			<Property Name="SizingEnabled" Value="False"/>
			<Property Name="ClippedByParent" Value="False"/>
			<Property Name="LimitWindowSize" Value="False"/>
			<Property Name="TitlebarEnabled" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0.5,-420},{0.5,-330},{0.5,420},{0.5,353}}"/>
			<Property Name="DragMovingEnabled" Value="False"/>
			<Property Name="AllowModalStateClick" Value="True"/>
			<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
			<Window Type="TaharezLook/common_text2bg" Name="tanhe/ditu/textbg">
