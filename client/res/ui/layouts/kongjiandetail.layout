<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="kongjiandetail">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,628},{0,564}}"/>
		<Window Type="DefaultWindow" Name="kongjiandetail/wndsaybg">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,9},{0,89},{0,617},{0,558}}"/>
			<Window Type="TaharezLook/ScrollablePane" Name="kongjiandetail/wndsaybg/scroll">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="Visible" Value="False"/>
				<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="HorzStepSize" Value="0.1"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="VertStepSize" Value="0.1"/>
				<Property Name="HorzOverlapSize" Value="0.01"/>
				<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,617},{0,466}}"/>
				<Property Name="VertOverlapSize" Value="0.01"/>
				<Property Name="HorzScrollPosition" Value="0.0"/>
				<Property Name="VertScrollPosition" Value="0.0"/>
				<AutoWindow NameSuffix="__auto_container__">
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="ChildExtentsArea" Value="l:0 t:0 r:0 b:0"/>
				</AutoWindow>
			</Window>
		</Window>
		<Window Type="TaharezLook/common_baibg" Name="kongjiandetail/bg">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,10},{0,10},{0,618},{0,87}}"/>
			<Property Name="MousePassThroughEnabled" Value="True"/>
		</Window>
		<Window Type="TaharezLook/Button" Name="kongjiandetail/btnsay">
			<Property Name="Font" Value="simhei-16"/>
			<Property Name="Text" Value="返 回"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="EnableClickAni" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,19},{0,15},{0,250},{0,78}}"/>
		</Window>
	</Window>
</GUILayout>
