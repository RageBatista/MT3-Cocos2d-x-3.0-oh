            <Property Name="AlwaysOnTop" Value="True" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="ImageSizeEnable" Value="False" />
            <Property Name="UnifiedAreaRect" Value="{{0.34375,0},{0.180662,12},{0.539063,0},{0.371501,12}}" />
