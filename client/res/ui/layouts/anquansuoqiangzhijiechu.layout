		<Window Type="TaharezLook/StaticText" Name="anquansuoqiangzhijiechu/text3">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="申请强制解锁后有10天审查期，审查结束后则会强制解锁并删除现有密码，在审查期限内，您将无法进行解锁修改密码等操作。中途可以取消申请，一旦取消申请后，再次申请的审查期限将重置为10天，请问是否进行强制解锁申请。"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="494.0"/>
			<Property Name="VertExtent" Value="153.956"/>
			<Property Name="EnableSound" Value="True"/>
