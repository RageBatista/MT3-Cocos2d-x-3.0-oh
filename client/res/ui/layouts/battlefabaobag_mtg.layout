<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="battlefabaodialog">
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/StaticImage" Name="battlefabaodialog_back">
			<Property Name="Image" Value="set:LoginBack2 image:CommonBack"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,-1},{0,0},{1,-1},{1,0}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/ImageButton" Name="battlefabaodialog/cancel">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="NormalImage" Value="set:fightui image:quxiao"/>
			<Property Name="PushedImage" Value="set:fightui image:quxiao"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="EnableClickAni" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{1,-100},{1,-119},{1,-14},{1,-24}}"/>
		</Window>
		<Window Type="TaharezLook/FrameWindow2" Name="battlefabaobag_mtg">
			<Property Name="Font" Value="hycyj-20"/>
			<Property Name="Text" Value="法 宝 背 包"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="ModalState" Value="True"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="RollUpEnabled" Value="True"/>
			<Property Name="SizingEnabled" Value="False"/>
			<Property Name="LimitWindowSize" Value="False"/>
			<Property Name="TitlebarEnabled" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0.5,-420},{0.5,-316},{0.5,420},{0.5,328}}"/>
			<Property Name="DragMovingEnabled" Value="False"/>
			<Window Type="TaharezLook/common_text2bg" Name="battlefabaobag_mtg/textbg">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,69},{0,152},{0,765},{0,496}}"/>
				<Window Type="TaharezLook/ScrollablePane" Name="battlefabaobag_mtg/textbg/list">
					<Property Name="Font" Value="simhei-12"/>
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="ContentArea" Value="l:-22 t:-1 r:653 b:322"/>
					<Property Name="EnableSound" Value="True"/>
					<Property Name="HorzStepSize" Value="0.1"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="VertStepSize" Value="0.1"/>
					<Property Name="HorzOverlapSize" Value="0.01"/>
					<Property Name="UnifiedAreaRect" Value="{{0,11},{0,12},{0,689},{0,332}}"/>
					<Property Name="VertOverlapSize" Value="0.01"/>
					<Property Name="HorzScrollPosition" Value="0.0"/>
					<Property Name="VertScrollPosition" Value="0.0031"/>
					<AutoWindow NameSuffix="__auto_container__">
						<Property Name="Scale" Value="x:1 y:1 z:1"/>
						<Property Name="ContentArea" Value="l:-22 t:-1 r:653 b:322"/>
						<Property Name="LuaForDialog" Value="True"/>
						<Property Name="ChildExtentsArea" Value="l:-22 t:-1 r:653 b:322"/>
						<Window Type="TaharezLook/ItemTable" Name="battlefabaobag_mtg/textbg/list/table">
							<Property Name="Font" Value="simhei-12"/>
							<Property Name="Scale" Value="x:1 y:1 z:1"/>
							<Property Name="SpaceX" Value="13"/>
							<Property Name="SpaceY" Value="9"/>
							<Property Name="StartX" Value="5"/>
							<Property Name="ColCount" Value="6"/>
							<Property Name="RowCount" Value="3"/>
							<Property Name="CellWidth" Value="100"/>
							<Property Name="CellHeight" Value="100"/>
							<Property Name="EnableSound" Value="True"/>
							<Property Name="LuaForDialog" Value="True"/>
							<Property Name="LimitWindowSize" Value="False"/>
							<Property Name="UnifiedAreaRect" Value="{{0,-22},{0,-1},{0,653},{0,322}}"/>
						</Window>
					</AutoWindow>
				</Window>
			</Window>
			<Window Type="TaharezLook/StaticText" Name="battlefabaobag_mtg/textshengyu">
				<Property Name="Font" Value="simhei-16"/>
				<Property Name="Text" Value="当前选中法宝剩余使用次数："/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="HorzExtent" Value="377.0"/>
				<Property Name="VertExtent" Value="29.3138"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="TextColours" Value="tl:FF5B3A1F tr:FF5B3A1F bl:FF5B3A1F br:FF5B3A1F"/>
				<Property Name="BorderColour" Value="FF003454"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,347},{0,501},{0,717},{0,532}}"/>
			</Window>
			<Window Type="TaharezLook/StaticText" Name="battlefabaobag_mtg/text">
				<Property Name="Font" Value="simhei-16"/>
				<Property Name="Text" Value="10"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="HorzExtent" Value="29.0"/>
				<Property Name="VertExtent" Value="29.3138"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="TextColours" Value="tl:FF0A6404 tr:FF0A6404 bl:FF0A6404 br:FF0A6404"/>
				<Property Name="BorderColour" Value="FF003454"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,709},{0,502},{0,750},{0,534}}"/>
			</Window>
			<Window Type="TaharezLook/dangebutton" Name="battlefabaobag_mtg/btnshiyong">
				<Property Name="Font" Value="simhei-18"/>
				<Property Name="Text" Value="使 用"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="SizeType" Value="Auto"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="EnableClickAni" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,302},{0,546},{0,533},{0,609}}"/>
			</Window>
			<Window Type="TaharezLook/GroupButton8" Name="battlefabaobag_mtg/btn1">
				<Property Name="Font" Value="simhei-16"/>
				<Property Name="Text" Value="全 部"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="EnableClickAni" Value="False"/>
				<Property Name="UnifiedAreaRect" Value="{{0,74},{0,78},{0,183},{0,140}}"/>
			</Window>
		</Window>
	</Window>
</GUILayout>
