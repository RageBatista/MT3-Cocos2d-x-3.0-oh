			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,39},{0,78},{0,558},{0,118}}"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="shengsizhanguize_mtg/text2">
			<Property Name="Font" Value="simhei-12"/>
