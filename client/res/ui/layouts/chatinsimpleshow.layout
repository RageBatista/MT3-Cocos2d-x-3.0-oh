<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/common_shurukuang" Name="chatinsimpleshow">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-412},{0.5,-239},{0.5,200},{0.5,-189}}"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Window Type="TaharezLook/RichEditbox" Name="chatinsimpleshow/main">
			<Property Name="Font" Value="simhei-10"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="LineSpace" Value="1.0"/>
			<Property Name="BlinkCaret" Value="True"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="MaxTextLength" Value="2147483647"/>
			<Property Name="UnifiedAreaRect" Value="{{0.046406,-15},{0.168858,0},{0.973906,4},{0.848858,0}}"/>
			<Property Name="BackGroundEnable" Value="False"/>
			<Property Name="NormalTextColour" Value="FFE60012"/>
			<Property Name="BlinkCaretTimeout" Value="0.5"/>
			<Property Name="SelectedTextColour" Value="FF693F00"/>
			<Property Name="TextParsingEnabled" Value="False"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/Button" Name="chatinsimpleshow/close">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Text" Value="取消"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="ClippedByParent" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,623},{0,0},{0,723},{0,50}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/Button" Name="chatinsimpleshow/OK">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Text" Value="确定"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="ClippedByParent" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,725},{0,0},{0,825},{0,50}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
	</Window>
</GUILayout>
