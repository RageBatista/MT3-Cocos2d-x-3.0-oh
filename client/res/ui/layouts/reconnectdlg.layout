<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="reconnectdlg">
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="ReConnectDlg"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/common_goodstips" Name="reconnectdlg/background">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,423},{0,137}}"/>
			<Property Name="VerticalAlignment" Value="Centre"/>
			<Property Name="HorizontalAlignment" Value="Centre"/>
			<Property Name="AllowModalStateClick" Value="True"/>
			<Window Type="TaharezLook/StaticText" Name="reconnectdlg/background/text">
				<Property Name="Font" Value="simhei-14"/>
				<Property Name="Text" Value="断线重连中……"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="HorzExtent" Value="180.0"/>
				<Property Name="VertExtent" Value="25.6593"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="TextColours" Value="tl:FFFFF2DF tr:FFFFF2DF bl:FFFFF2DF br:FFFFF2DF"/>
				<Property Name="BorderColour" Value="FF003454"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,-56},{0,-1},{0,131},{0,29}}"/>
				<Property Name="VerticalAlignment" Value="Centre"/>
				<Property Name="HorizontalAlignment" Value="Right"/>
				<Property Name="AllowModalStateClick" Value="True"/>
			</Window>
			<Window Type="TaharezLook/StaticImage" Name="reconnectdlg/background/touxiang">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,73},{0,53},{0,106},{0,81}}"/>
				<Property Name="AllowModalStateClick" Value="True"/>
			</Window>
		</Window>
	</Window>
</GUILayout>
