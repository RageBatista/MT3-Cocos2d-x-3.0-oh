<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticImage" Name="shoujiyanzheng">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Image" Value="set:laohuji image:dianka"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="ShouJiYanZheng"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-418},{0.5,-359},{0.5,420},{0.5,284}}"/>
		<Window Type="TaharezLook/StaticText" Name="shoujiyanzheng/text1">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="尊敬的用户您好："/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="208.0"/>
			<Property Name="VertExtent" Value="25.6593"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FF50321A tr:FF50321A bl:FF50321A br:FF50321A"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,181},{0,309},{0,379},{0,341}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="shoujiyanzheng/text2">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="关联后可以保障您的账号安全，而且还可以获得丰厚奖励.如您未进行手机关联，则会影响拍卖行和红包功能的正常操作，请及时绑定。"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="Visible" Value="False"/>
			<Property Name="HorzExtent" Value="429.0"/>
			<Property Name="VertExtent" Value="102.637"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="TextColours" Value="tl:FF50321A tr:FF50321A bl:FF50321A br:FF50321A"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="LuaMemberName" Value="m_desc_free"/>
			<Property Name="HorzFormatting" Value="WordWrapLeftAligned"/>
			<Property Name="UnifiedAreaRect" Value="{{0,214},{0,350},{0,658},{0,493}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/Button" Name="shoujiyanzheng/btn">
			<Property Name="Font" Value="simhei-16"/>
			<Property Name="Text" Value="验证手机"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="LuaMemberName" Value="m_btn"/>
			<Property Name="EnableClickAni" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,329},{0,500},{0,560},{0,563}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
		</Window>
		<Window Type="TaharezLook/StaticText" Name="shoujiyanzheng/text3">
			<Property Name="Font" Value="simhei-14"/>
			<Property Name="Text" Value="为保障您的账号安全，拍卖行、红包和交易所功能需要验证手机后才可使用。您也可通过系统设置进行验证手机。"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="442.0"/>
			<Property Name="VertExtent" Value="76.978"/>
