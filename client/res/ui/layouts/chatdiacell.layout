            <Property Name="Image" Value="set:liaotian image:liaotian_pindaodiban" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="UnifiedAreaRect" Value="{{0,78},{0,3},{0,129},{0,33}}" />
