                <Property Name="Font" Value="simhei-10" />
                <Property Name="Text" Value="频道" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="HorzExtent" Value="36" />
                <Property Name="VertExtent" Value="18.3282" />
                <Property Name="AlwaysOnTop" Value="True" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="BorderColour" Value="FFFFFFFF" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,3},{0,0},{0.001664,50},{0,24}}" />
            </Window>
        </Window>
        <Window Type="TaharezLook/StaticImage" Name="chatdiacell/textbg/arrow" >
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Image" Value="set:ccui3 image:zuobianc" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
