<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticImage" Name="fubenguide">
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="Visible" Value="False"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.00195313,0},{0.5,-193},{0,272},{0.5,61}}"/>
		<Property Name="MousePassThroughEnabled" Value="True"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/Button" Name="fubenguide/btn">
			<Property Name="Text" Value="离开副本"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="SoundResource" Value="button.ogg"/>
			<Property Name="UnifiedAreaRect" Value="{{0.00370372,0},{0.661417,0},{0.006135,269.552},{0,216}}"/>
		</Window>
		<Window Type="TaharezLook/StaticImage" Name="fubenguide/image">
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,0},{0,216},{0,269},{0,250}}"/>
			<Window Type="TaharezLook/StaticText" Name="fubenguide/time">
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="TextColours" Value="tl:FF000000 tr:FF000000 bl:FF000000 br:FF000000"/>
				<Property Name="BorderColour" Value="FF003454"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="HorzFormatting" Value="HorzCentred"/>
				<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,195},{0,30}}"/>
				<Property Name="HorizontalAlignment" Value="Centre"/>
			</Window>
		</Window>
		<Window Type="TaharezLook/ImageButton" Name="fubenguidecell">
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="SoundResource" Value="button.ogg"/>
			<Property Name="UnifiedAreaRect" Value="{{0.00740741,0},{0.011811,0},{0,266},{0.011811,100}}"/>
			<Window Type="TaharezLook/StaticText" Name="fubenguide/name">
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="TextColours" Value="tl:FF6EE6FF tr:FF6EE6FF bl:FF6EE6FF br:FF6EE6FF"/>
				<Property Name="BorderColour" Value="FF003454"/>
				<Property Name="BorderEnable" Value="True"/>
