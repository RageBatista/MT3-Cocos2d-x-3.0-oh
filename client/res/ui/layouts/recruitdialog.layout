<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/FrameWindow" Name="recruitdialog">
		<Property Name="Font" Value="hycyj-20"/>
		<Property Name="Text" Value="招 募"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="RecruitDlg"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="RollUpEnabled" Value="True"/>
		<Property Name="SizingEnabled" Value="False"/>
		<Property Name="LimitWindowSize" Value="False"/>
		<Property Name="TitlebarEnabled" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-552},{0.5,-334},{0.5,552},{0.5,348}}"/>
		<Property Name="DragMovingEnabled" Value="False"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/common_text2bg" Name="recruitdialog/liebiao/diban">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="LimitWindowSize" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,74},{0,82},{0,414},{0,649}}"/>
			<Property Name="MousePassThroughEnabled" Value="True"/>
			<Window Type="TaharezLook/ScrollablePane" Name="recruitdialog/liebiao/diban/list">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="HorzStepSize" Value="0.1"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="VertStepSize" Value="0.1"/>
				<Property Name="HorzOverlapSize" Value="0.01"/>
				<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,340},{0,567}}"/>
				<Property Name="VertOverlapSize" Value="0.01"/>
				<Property Name="HorzScrollPosition" Value="0.0"/>
				<Property Name="VertScrollPosition" Value="0.0"/>
				<AutoWindow NameSuffix="__auto_container__">
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="ChildExtentsArea" Value="l:0 t:0 r:0 b:0"/>
				</AutoWindow>
			</Window>
		</Window>
		<Window Type="DefaultWindow" Name="recruitdialog/right">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="LimitWindowSize" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,410},{0,73},{0,1034},{0,650}}"/>
			<Window Type="TaharezLook/common_text2bg" Name="recruitdialog/chatframe/xinxi">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="UnifiedAreaRect" Value="{{0,9},{0,9},{0,618},{0,576}}"/>
			</Window>
		</Window>
		<Window Type="TaharezLook/StaticImage" Name="recruitdialog/image">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Image" Value="set:diban image:haoyou"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="ClippedByParent" Value="False"/>
			<Property Name="UnifiedAreaRect" Value="{{0,37},{0,-19},{0,147},{0,89}}"/>
		</Window>
	</Window>
</GUILayout>
