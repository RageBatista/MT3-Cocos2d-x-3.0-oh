<?xml version="1.0" encoding="UTF-8"?>

<GUILayout >
    <Window Type="TaharezLook/StaticImage" Name="xiaoditu/mask" >
        <Property Name="Font" Value="simhei-12" />
        <Property Name="Image" Value="set:ccui1 image:tm" />
        <Property Name="Scale" Value="x:1 y:1 z:1" />
        <Property Name="ModalState" Value="True" />
        <Property Name="AlwaysOnTop" Value="True" />
        <Property Name="EnableSound" Value="True" />
        <Property Name="LuaForDialog" Value="True" />
        <Property Name="ClippedByParent" Value="False" />
        <Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}" />
        <Property Name="MousePassThroughEnabled" Value="True" />
        <Property Name="DisplaySizeChangePosEnabled" Value="False" />
        <Window Type="TaharezLook/common_ccxiaoditubg" Name="xiaoditu" >
            <Property Name="Font" Value="simhei-12" />
            <Property Name="Scale" Value="x:1 y:1 z:1" />
            <Property Name="AlwaysOnTop" Value="True" />
            <Property Name="EnableSound" Value="True" />
            <Property Name="LuaForDialog" Value="True" />
            <Property Name="UnifiedAreaRect" Value="{{0,448},{0,137},{0,848},{0,537}}" />
            <Property Name="DisplaySizeChangePosEnabled" Value="False" />
            <Window Type="TaharezLook/ImageButton" Name="xiaoditu/close" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="SizeType" Value="Auto" />
                <Property Name="ModalState" Value="True" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="NormalImage" Value="set:ccui image:cxxx" />
                <Property Name="PushedImage" Value="set:ccui image:cxxx" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="EnableClickAni" Value="True" />
                <Property Name="ClippedByParent" Value="False" />
                <Property Name="UnifiedAreaRect" Value="{{0,349},{0,-8},{0,409},{0,50}}" />
            </Window>
            <Window Type="TaharezLook/StaticImage" Name="xiaoditu/image" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,10},{0,10},{1,-10},{1,-10}}" />
            </Window>
            <Window Type="TaharezLook/ImageButton" Name="xiaoditu/btn" >
                <Property Name="Font" Value="simhei-16" />
                <Property Name="Scale" Value="x:1 y:1 z:1"/>
			    <Property Name="SizeType" Value="Auto"/>
			    <Property Name="HoverImage" Value="set:worldmapbg image:xunzhao"/>
		    	<Property Name="EnableSound" Value="True"/>
		    	<Property Name="NormalImage" Value="set:worldmapbg image:xunzhao"/>
			    <Property Name="PushedImage" Value="set:worldmapbg image:xunzhao"/>
			    <Property Name="LuaForDialog" Value="True"/>
			    <Property Name="EnableClickAni" Value="True"/>
			    <Property Name="ClippedByParent" Value="False"/>
			    <Property Name="UnifiedAreaRect" Value="{{0,85},{0,5},{0,162},{0,80}}"/>
            </Window>
            <Window Type="TaharezLook/ImageButton" Name="xiaoditu/btn1" >
                <Property Name="Font" Value="simhei-16"/>
		     	<Property Name="Scale" Value="x:1 y:1 z:1"/>
			    <Property Name="SizeType" Value="Auto"/>
			    <Property Name="HoverImage" Value="set:worldmapbg image:qiehuan"/>
			    <Property Name="EnableSound" Value="True"/>
			    <Property Name="NormalImage" Value="set:worldmapbg image:qiehuan"/>
			    <Property Name="PushedImage" Value="set:worldmapbg image:qiehuan"/>
			    <Property Name="LuaForDialog" Value="True"/>
			    <Property Name="EnableClickAni" Value="True"/>
			    <Property Name="ClippedByParent" Value="False"/>
			    <Property Name="UnifiedAreaRect" Value="{{0,6},{0,5},{0,83},{0,80}}"/>
            </Window>
            <Window Type="TaharezLook/common_goodstips" Name="xiaoditu/kuang" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="Visible" Value="False" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,1},{0,6},{0,272},{0,206}}" />
                <Window Type="TaharezLook/ScrollablePane" Name="xiaoditu/kuang/list" >
                    <Property Name="Font" Value="simhei-12" />
                    <Property Name="Scale" Value="x:1 y:1 z:1" />
                    <Property Name="ContentArea" Value="l:0 t:0 r:0 b:0" />
                    <Property Name="EnableSound" Value="True" />
                    <Property Name="HorzStepSize" Value="0.1" />
                    <Property Name="LuaForDialog" Value="True" />
                    <Property Name="VertStepSize" Value="0.1" />
                    <Property Name="HorzOverlapSize" Value="0.01" />
                    <Property Name="UnifiedAreaRect" Value="{{0,10},{0,8},{0,286},{0,194}}" />
                    <Property Name="VertOverlapSize" Value="0.01" />
                    <Property Name="HorzScrollPosition" Value="0" />
                    <Property Name="VertScrollPosition" Value="0" />
                    <AutoWindow NameSuffix="__auto_container__" >
                        <Property Name="Scale" Value="x:1 y:1 z:1" />
                        <Property Name="ContentArea" Value="l:0 t:0 r:0 b:0" />
                        <Property Name="LuaForDialog" Value="True" />
                        <Property Name="ChildExtentsArea" Value="l:0 t:0 r:0 b:0" />
                    </AutoWindow>
                </Window>
            </Window>
            <Window Type="TaharezLook/StaticImage" Name="xiaoditu/effet" >
                <Property Name="Font" Value="simhei-12" />
                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="UnifiedAreaRect" Value="{{0,11},{0,6},{0,53},{0,49}}" />
            </Window>
        </Window>
    </Window>
</GUILayout>
