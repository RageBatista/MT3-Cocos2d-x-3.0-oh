<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="DefaultWindow" Name="pingmusuo">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="AlwaysOnTop" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{1,0},{1,0}}"/>
		<Property Name="DisplaySizeChangePosEnabled" Value="False"/>
		<Window Type="TaharezLook/StaticText" Name="pingmusuo/wenzi">
			<Property Name="Font" Value="simhei-20"/>
			<Property Name="Text" Value="滑动屏幕解锁"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="HorzExtent" Value="222.0"/>
			<Property Name="VertExtent" Value="36.654"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0.5,-74},{0.5,-54},{0.5,206},{0.5,52}}"/>
		</Window>
		<Window Type="TaharezLook/StaticImage" Name="pingmusuo/ditu">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Image" Value="set:siwangtixing image:ban"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0.5,-211},{0.5,-67},{0.5,189},{0.5,73}}"/>
		</Window>
		<Window Type="TaharezLook/ImageButton" Name="pingmusuo/pingmusuoanniu">
			<Property Name="Font" Value="hycyj-20"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="HoverImage" Value="set:siwangtixing image:suo"/>
			<Property Name="AlwaysOnTop" Value="True"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="NormalImage" Value="set:siwangtixing image:suo"/>
			<Property Name="PushedImage" Value="set:siwangtixing image:suo"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0.5,-197},{0.5,-53},{0.5,-82},{0.5,57}}"/>
		</Window>
	</Window>
</GUILayout>
