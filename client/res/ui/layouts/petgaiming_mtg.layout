                <Property Name="UnifiedAreaRect" Value="{{0,71},{0,128},{0,419},{0,178}}" />
                <Property Name="AllowModalStateClick" Value="True" />
                <Window Type="TaharezLook/Editbox" Name="petgaiming_mtg/shurubg/editbox" >
