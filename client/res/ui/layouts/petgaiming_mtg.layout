                <Property Name="Scale" Value="x:1 y:1 z:1" />
                <Property Name="HorzExtent" Value="310" />
                <Property Name="VertExtent" Value="23.828" />
                <Property Name="EnableSound" Value="True" />
                <Property Name="TextColours" Value="tl:FF8C5E2A tr:FF8C5E2A bl:FF8C5E2A br:FF8C5E2A" />
                <Property Name="BorderColour" Value="FFFFFFFF" />
                <Property Name="LuaForDialog" Value="True" />
                <Property Name="LuaMemberName" Value="descText" />
                <Property Name="UnifiedAreaRect" Value="{{0,68},{0,70},{0,478},{0,110}}" />
                <Property Name="AllowModalStateClick" Value="True" />
            </Window>
            <Window Type="TaharezLook/common_shurukuang1" Name="petgaiming_mtg/shurubg" >
