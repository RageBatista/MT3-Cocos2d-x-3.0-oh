			<Property Name="HorzFormatting" Value="RightAligned"/>
			<Property Name="UnifiedAreaRect" Value="{{0,-101},{0,15},{0,66},{0,40}}"/>
			<Property Name="HorizontalAlignment" Value="Right"/>
		</Window>
		<Window Type="TaharezLook/common_chatbg_right" Name="jinglinguser/questbg">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,5},{0,47},{0,493},{0,90}}"/>
			<Window Type="TaharezLook/RichEditbox" Name="jinglinguser/questbg/edit">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="ReadOnly" Value="True"/>
