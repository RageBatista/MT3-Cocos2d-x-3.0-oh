<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/FrameWindow2" Name="shenshouchongzhi">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Text" Value="神兽重置"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="RollUpEnabled" Value="True"/>
		<Property Name="SizingEnabled" Value="False"/>
		<Property Name="TitlebarEnabled" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-420},{0.5,-332},{0.5,420},{0.5,348}}"/>
		<Property Name="DragMovingEnabled" Value="False"/>
		<Window Type="TaharezLook/Button" Name="shenshouchongzhi/duihuan">
			<Property Name="Font" Value="simhei-16"/>
			<Property Name="Text" Value="重 置"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="SizeType" Value="Auto"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="EnableClickAni" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,315},{0,581},{0,528},{0,644}}"/>
		</Window>
		<Window Type="TaharezLook/common_text2bg" Name="shenshouchongzhi/di">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,73},{0,80},{0,764},{0,558}}"/>
			<Window Type="TaharezLook/ScrollablePane" Name="shenshouchongzhi/list">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="HorzStepSize" Value="0.1"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="VertStepSize" Value="0.1"/>
				<Property Name="HorzOverlapSize" Value="0.01"/>
				<Property Name="UnifiedAreaRect" Value="{{0,1},{0,4},{0,692},{0,473}}"/>
				<Property Name="VertOverlapSize" Value="0.01"/>
				<Property Name="HorzScrollPosition" Value="0.0"/>
				<Property Name="VertScrollPosition" Value="0.0"/>
				<AutoWindow NameSuffix="__auto_container__">
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="ChildExtentsArea" Value="l:0 t:0 r:0 b:0"/>
				</AutoWindow>
			</Window>
		</Window>
	</Window>
</GUILayout>
