<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/FrameWindowCharge" Name="rolechargedlg">
		<Property Name="Font" Value="simhei-13"/>
		<Property Name="Text" Value="角色累计"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="LuaClass" Value="DayChargeDialog"/>
		<Property Name="ModalState" Value="True"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="IsPixelDecide" Value="True"/>
		<Property Name="RollUpEnabled" Value="True"/>
		<Property Name="SizingEnabled" Value="False"/>
		<Property Name="SoundResource" Value="dlgopen.ogg"/>
		<Property Name="LimitWindowSize" Value="False"/>
		<Property Name="TitlebarEnabled" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0.5,-355},{0.5,-295},{0.5,354},{0.5,294}}"/>
		<Property Name="DragMovingEnabled" Value="False"/>
		<Property Name="CloseSoundResource" Value="dlgopen.ogg"/>
		<Property Name="AllowModalStateClick" Value="True"/>
		<Property Name="AllowShowWithModalState" Value="True"/>
		<Window Type="TaharezLook/common_text2bg" Name="rolechargedlg/bg">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,26.2184},{0,52.0969},{0,685.468},{0,561.347}}"/>
			<Property Name="AllowModalStateClick" Value="True"/>
			<Window Type="TaharezLook/ScrollablePane" Name="rolechargedlg/bg/scrollable">
				<Property Name="Font" Value="simhei-12"/>
				<Property Name="Scale" Value="x:1 y:1 z:1"/>
				<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
				<Property Name="EnableSound" Value="True"/>
				<Property Name="HorzStepSize" Value="0.1"/>
				<Property Name="LuaForDialog" Value="True"/>
				<Property Name="VertStepSize" Value="0.1"/>
				<Property Name="HorzOverlapSize" Value="0.01"/>
				<Property Name="UnifiedAreaRect" Value="{{0,12.3},{0,8.3},{0,651.55},{0,497.55}}"/>
				<Property Name="VertOverlapSize" Value="0.01"/>
				<Property Name="HorzScrollPosition" Value="0.0"/>
				<Property Name="VertScrollPosition" Value="0.0"/>
				<Property Name="AllowModalStateClick" Value="True"/>
				<AutoWindow NameSuffix="__auto_container__">
					<Property Name="Scale" Value="x:1 y:1 z:1"/>
					<Property Name="ContentArea" Value="l:0 t:0 r:0 b:0"/>
					<Property Name="LuaForDialog" Value="True"/>
					<Property Name="ChildExtentsArea" Value="l:0 t:0 r:0 b:0"/>
				</AutoWindow>
			</Window>
		</Window>
	</Window>
</GUILayout>
