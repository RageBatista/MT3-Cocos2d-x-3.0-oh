<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/StaticText" Name="zhuanzhiwuqishuoming">
		<Property Name="Font" Value="simhei-14"/>
		<Property Name="Text" Value="1、所转换的武器必须是原职业使用武器，转换后的武器造型为当前职业使用的武器造型
2、每次转换职业后，可获得2次转换武器造型的机会。（转换武器机会不叠加）
3、转换武器后，所转换武器有60天冷却时间
4、转换前绑定的武器，转换后也为绑定
5、武器转换前后属性、特技、特效不会改变"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="HorzExtent" Value="52.0"/>
		<Property Name="VertExtent" Value="25.6593"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="TextColours" Value="tl:FF50321A tr:FF50321A bl:FF50321A br:FF50321A"/>
		<Property Name="BorderColour" Value="FF003454"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="HorzFormatting" Value="WordWrapLeftAligned"/>
		<Property Name="UnifiedAreaRect" Value="{{0,1},{0,1},{0,631},{0,201}}"/>
		<Window Type="DefaultWindow" Name="zhuanzhiwuqishuoming/fangbeng">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,0.0783594},{0,0.00041665},{0,0.328359},{0,0.250417}}"/>
		</Window>
	</Window>
</GUILayout>
