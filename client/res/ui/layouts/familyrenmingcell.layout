<?xml version="1.0" encoding="UTF-8"?>
<GUILayout>
	<Window Type="TaharezLook/common_ty" Name="familyrenmingcell">
		<Property Name="Font" Value="simhei-12"/>
		<Property Name="Scale" Value="x:1 y:1 z:1"/>
		<Property Name="SizeType" Value="Auto"/>
		<Property Name="EnableSound" Value="True"/>
		<Property Name="LuaForDialog" Value="True"/>
		<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,210},{0,50}}"/>
		<Window Type="TaharezLook/StaticText" Name="familyrenmingcell/text">
			<Property Name="Font" Value="simhei-12"/>
			<Property Name="Scale" Value="x:1 y:1 z:1"/>
			<Property Name="EnableSound" Value="True"/>
			<Property Name="BorderColour" Value="FF003454"/>
			<Property Name="LuaForDialog" Value="True"/>
			<Property Name="UnifiedAreaRect" Value="{{0,0},{0,0},{0,210},{0,50}}"/>
		</Window>
	</Window>
</GUILayout>
