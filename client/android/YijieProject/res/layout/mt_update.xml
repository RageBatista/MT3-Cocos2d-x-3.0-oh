<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent" >

    <ImageView
        android:id="@+id/mt3_update_image"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:scaleType="centerCrop"
        android:src="@drawable/loadingback" />

    <LinearLayout
        android:id="@+id/mt3_update_linearLayout1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:padding="5dp" >

        <LinearLayout
            android:id="@+id/mt3_update_linearLayout2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/mt3_update_textViewCurVerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mt3_currentres"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/updatetextcolor" />

            <TextView
                android:id="@+id/mt3_update_TextViewCurVer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/updatetextcolor" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mt3_update_linearLayout3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/mt3_update_TextViewNewVerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mt3_latestres"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/updatetextcolor" />

            <TextView
                android:id="@+id/mt3_update_TextViewNewVer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/updatetextcolor" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/mt3_update_imageView1"
        android:layout_width="fill_parent"
        android:layout_height="30dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:scaleType="fitXY"
        android:src="@drawable/img1"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true" >

        <TextView
            android:id="@+id/mt3_update_textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mt3_updatetips"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/updatetextcolor"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/mt3_update_textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/updatetextcolor"
            android:textSize="16dp" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/mt3_update_RelativeLayout"
        android:layout_width="332dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:visibility="gone" >

        <ImageView
            android:id="@+id/mt3_update_imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/formbg" />

        <TextView
            android:id="@+id/mt3_update_textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="40dp"
            android:text="获取版本信息中..."
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/textcolor"
            android:textSize="16dp" />

        <Button
            android:id="@+id/mt3_update_button2"
            android:layout_width="92dp"
            android:layout_height="30dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="15dp"
            android:layout_marginRight="40dp"
            android:background="@drawable/btnup"
            android:text="确定"
            android:textColor="@color/updatetextcolor" />

        <TextView
            android:id="@+id/mt3_update_textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:text="版本更新"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/updatetextcolor"
            android:textSize="20dp" />

        <Button
            android:id="@+id/mt3_update_button1"
            android:layout_width="92dp"
            android:layout_height="30dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_marginBottom="15dp"
            android:layout_marginLeft="40dp"
            android:background="@drawable/btnup"
            android:text="取消"
            android:textColor="@color/updatetextcolor" />

    </RelativeLayout>

</RelativeLayout>