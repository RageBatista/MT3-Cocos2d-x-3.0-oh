Diagnostics:
  Suppress:
    - unused-includes
  ClangTidy:
    Remove:
      - readability-misleading-indentation

---
# dependencies 目录：第三方代码，仅抑制无法修复的编译错误
If:
  PathMatch: dependencies/RapidXml/.*
Diagnostics:
  Suppress:
    - "*"
---
If:
  PathMatch: dependencies/LJXML/.*
Diagnostics:
  Suppress:
    - "*"
---
If:
  PathMatch: engine/soundarea/.*
Diagnostics:
  Suppress:
    - "*"
---
If:
  PathMatch: engine/common/nuxml\.h
Diagnostics:
  Suppress:
    - "*"
---
If:
  PathMatch: engine/engine/nuenginebase\.h
Diagnostics:
  Suppress:
    - "*"
---
If:
  PathMatch: engine/world/nuworld\.h
Diagnostics:
  Suppress:
    - "*"
---
If:
  PathMatch: engine/engine/nuengine\.h
Diagnostics:
  Suppress:
    - "*"
---
# tolua++ 生成的绑定文件，诊断由 clangd 配置确保正确性
If:
  PathMatch: client/FireClient/Application/Framework/LuaEngine(Win32)?\.cpp
Diagnostics:
  Suppress:
    - "*"
---
# CEGUI 0.7.9-r5 源码（第三方库，避免 clangd 误报）
If:
  PathMatch: tools/CEGUI-0.7.9-r5/cegui/src/.*
Diagnostics:
  Suppress:
    - "*"
---
# Cocos2d-x 3.0-oh 引擎源码（第三方库，避免 clangd 误报）
If:
  PathMatch: cocos2d-x-3.0-oh/cocos/.*
Diagnostics:
  Suppress:
    - "*"
---
If:
  PathMatch: cocos2d-x-3.0-oh/extensions/.*
Diagnostics:
  Suppress:
    - "*"
---
If:
  PathMatch: cocos2d-x-3.0-oh/external/.*
Diagnostics:
  Suppress:
    - "*"