# Git LFS 配置 - 大型二进制文件
# 注意：LFS 已禁用以避免 GitHub LFS 配额限制

# 预编译库文件
# *.lib filter=lfs diff=lfs merge=lfs -text
# *.dll filter=lfs diff=lfs merge=lfs -text
# *.exp filter=lfs diff=lfs merge=lfs -text
# *.pdb filter=lfs diff=lfs merge=lfs -text
# *.a filter=lfs diff=lfs merge=lfs -text
# *.so filter=lfs diff=lfs merge=lfs -text
# *.dylib filter=lfs diff=lfs merge=lfs -text
# 游戏资源文件
# *.wmv filter=lfs diff=lfs merge=lfs -text
# *.mp4 filter=lfs diff=lfs merge=lfs -text
# *.avi filter=lfs diff=lfs merge=lfs -text
# *.mp3 filter=lfs diff=lfs merge=lfs -text
# *.ogg filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
# 图像文件（大于 100KB 的通常使用 LFS）
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.ai filter=lfs diff=lfs merge=lfs -text
# 压缩包
# *.zip filter=lfs diff=lfs merge=lfs -text
# *.rar filter=lfs diff=lfs merge=lfs -text
# *.7z filter=lfs diff=lfs merge=lfs -text
# *.tar.gz filter=lfs diff=lfs merge=lfs -text
# 可执行文件
# *.exe filter=lfs diff=lfs merge=lfs -text
# Codex/docs governance files are maintained as UTF-8 no BOM + LF.
/.gitattributes text eol=lf
/.gitignore text eol=lf
/.codex/** text eol=lf
/.claude/**/*.md text eol=lf
/.agents/**/*.md text eol=lf
/.agents/**/*.ps1 text eol=lf
/tools/scripts/*.ps1 text eol=lf
/docs/**/*.md text eol=lf
# Win32 archived runtime/prebuilt binaries are byte-exact Git blobs; LFS remains disabled.
*.dll binary
*.lib binary
*.exp binary
*.pdb binary
*.exe binary
# Native/Android binaries are byte-exact vendored artifacts or build outputs.
*.a binary
*.so binary
*.jar binary
*.apk binary
*.ap_ binary
*.keystore binary
*.jks binary
# Cocos2d-x 2.2.6 third-party vendor files keep upstream bytes.
/cocos2d-x-2.2.6-mt3/cocos2dx/platform/third_party/** -text
# CEGUI 0.7.1 vendor snapshot - preserve original bytes under core.autocrlf=true.
/tools/CEGUI-0.7.1/** -text
/tools/CEGUI-0.7.1/**/*.dll binary
/tools/CEGUI-0.7.1/**/*.exe binary
/tools/CEGUI-0.7.1/**/*.lib binary
/tools/CEGUI-0.7.1/**/*.exp binary
*.sdf filter=lfs diff=lfs merge=lfs -text
*.ipch filter=lfs diff=lfs merge=lfs -text
*.pch filter=lfs diff=lfs merge=lfs -text
*.ljfp filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text
*.apk filter=lfs diff=lfs merge=lfs -text
*.ap_ filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xls filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
*.xml filter=lfs diff=lfs merge=lfs -text
*.json filter=lfs diff=lfs merge=lfs -text
*.tsv filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.tar.xz filter=lfs diff=lfs merge=lfs -text
*.xlsm filter=lfs diff=lfs merge=lfs -text
*.txt filter=lfs diff=lfs merge=lfs -text
*.tlog filter=lfs diff=lfs merge=lfs -text
*.abi filter=lfs diff=lfs merge=lfs -text
*.idb filter=lfs diff=lfs merge=lfs -text
*.rp filter=lfs diff=lfs merge=lfs -text
*.ljpm filter=lfs diff=lfs merge=lfs -text
*.dex filter=lfs diff=lfs merge=lfs -text
*.SF filter=lfs diff=lfs merge=lfs -text
*.MF filter=lfs diff=lfs merge=lfs -text
client/android/LocojoyProject/assets/res/** filter=lfs diff=lfs merge=lfs -text
client/android/LocojoyProject64/assets/res/** filter=lfs diff=lfs merge=lfs -text
temp/apk_analysis/working_apk/assets/res/** filter=lfs diff=lfs merge=lfs -text
assets/dev_res/** filter=lfs diff=lfs merge=lfs -text
assets/unpacked_res/** filter=lfs diff=lfs merge=lfs -text
assets/formal_results_unpack_20260423/** filter=lfs diff=lfs merge=lfs -text
assets/source_template_reports/** filter=lfs diff=lfs merge=lfs -text
assets/source_template_promoted/** filter=lfs diff=lfs merge=lfs -text
assets/source_template_reports_targets/** filter=lfs diff=lfs merge=lfs -text
assets/source_template_promoted_targets/** filter=lfs diff=lfs merge=lfs -text
assets/source_template_reports_unresolved/** filter=lfs diff=lfs merge=lfs -text
assets/source_template_promoted_unresolved/** filter=lfs diff=lfs merge=lfs -text
# VS Code workspace configuration must stay as regular text JSON.
/.vscode/*.json text eol=lf -filter -diff -merge
# Roo Code workspace configuration must stay as regular text JSON.
/.roo/*.json text eol=lf -filter -diff -merge
# Resource UI baselines are small reviewable JSON snapshots; keep them outside LFS.
/tools/scripts/baselines/*.json text eol=lf -filter -diff -merge
tools/ExcelParse2auto/** !text !filter !merge !diff
