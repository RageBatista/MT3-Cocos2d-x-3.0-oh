# Git LFS 配置 - 完全禁用
# 生成时间: 2026-07-21
# 原因: GitHub LFS 配额超限，所有 LFS 规则已禁用

# 注意: 本文件完全禁用了 Git LFS，所有文件使用普通 Git 对象存储

# ============ 基础文本/二进制配置 ============
# 所有文本文件使用 LF 换行符
* text=auto

# 二进制文件标记
*.dll binary
*.lib binary
*.exp binary
*.pdb binary
*.exe binary
*.a binary
*.so binary
*.jar binary
*.apk binary
*.ap_ binary
*.keystore binary
*.jks binary
*.sdf binary
*.ipch binary
*.pch binary
*.obj binary
*.otf binary

# ============ 开发配置文件 ============
/.gitattributes text eol=lf
/.gitignore text eol=lf
/.codex/** text eol=lf
/.claude/**/*.md text eol=lf
/.claude/scripts/audit_codex_guardrails.ps1 text eol=lf
/.claude/scripts/audit_mt3_docs.ps1 text eol=lf
/.claude/scripts/audit_mt3_docs.py text eol=lf
/.agents/**/*.md text eol=lf
/.agents/**/*.ps1 text eol=lf
/tools/scripts/*.ps1 text eol=lf
/docs/**/*.md text eol=lf

# ============ VS Code / Roo Code 配置 ============
/.vscode/*.json text eol=lf -filter -diff -merge
/.roo/*.json text eol=lf -filter -diff -merge
/tools/scripts/baselines/*.json text eol=lf -filter -diff -merge

# ============ Claude Code 配置 ============
/.claude/tests/*.ps1 text eol=lf
/.claude/config/**/*.json -filter diff merge text eol=lf
/.claude/hooks/*.json -filter diff merge text eol=lf
/.agents/**/*.txt -filter diff merge text eol=lf
/.agents/skills/**/agents/openai.yaml -filter diff merge text eol=lf

# ============ 第三方库配置 ============
/cocos2d-x-2.2.6-mt3/cocos2dx/platform/third_party/** -text

# ============ CEGUI 工具目录 ============
/tools/CEGUI-0.7.1/** -text -filter
/tools/CEGUI-0.7.1/**/*.dll binary
/tools/CEGUI-0.7.1/**/*.exe binary
/tools/CEGUI-0.7.1/**/*.lib binary
/tools/CEGUI-0.7.1/**/*.exp binary

# ============ 其他工具目录 ============
/tools/CELayoutEditor-0.7.1/** -filter
/tools/CEImagesetEditor-0.7.1/** -filter
/tools/ExcelParse2auto/** -filter
/tools/codex/** -filter diff merge text eol=lf

# ============ 客户端资源目录 (完全禁用 LFS) ============
/client/resource/res/** -filter
/client/resource/res/**/*.mp4 -diff -merge -text
/client/resource/res/**/*.ttf -diff -merge -text
/client/resource/res/**/*.png -diff -merge -text
/client/resource/res/**/*.jpg -diff -merge -text
/client/resource/res/**/*.ogg -diff -merge -text
/client/resource/res/**/*.wav -diff -merge -text

# ============ Android 资源目录 (完全禁用 LFS) ============
client/android/LocojoyProject/assets/res/** -filter
client/android/LocojoyProject64/assets/res/** -filter

# ============ 其他资源目录 (完全禁用 LFS) ============
temp/apk_analysis/working_apk/assets/res/** -filter
assets/dev_res/** -filter
assets/unpacked_res/** -filter
assets/formal_results_unpack_20260423/** -filter
assets/source_template_reports/** -filter
assets/source_template_promoted/** -filter
assets/source_template_reports_targets/** -filter
assets/source_template_promoted_targets/** -filter
assets/source_template_reports_unresolved/** -filter
assets/source_template_promoted_unresolved/** -filter

# ============ pcre 依赖特殊处理 ============
/dependencies/pcre-8.31/prj2/pcrelib/pcrelib/._pcrelib-Prefix.pch -filter -diff -merge -text
/dependencies/pcre-8.31/prj2/pcrelib/pcrelib/pcrelib-Prefix.pch -filter -diff -merge -text

# ============ 历史归档 CSV ============
/docs/09-历史归档/文档审计/2026-07-14-docs逐篇审查清单.csv -filter diff merge text eol=crlf

# ============ 大型二进制文件类型 (禁用 LFS，使用普通 Git) ============
# 这些文件现在使用普通 Git blob 存储，不消耗 LFS 配额
*.ttf -filter binary
*.png -filter binary
*.jpg -filter binary
*.jpeg -filter binary
*.ogg -filter binary
*.wav -filter binary
*.mp4 -filter binary
*.mp3 -filter binary
*.avi -filter binary
*.wmv -filter binary
*.tar.xz -filter binary
*.zip -filter binary
*.rar -filter binary
*.7z -filter binary
*.tar.gz -filter binary
*.ljfp -filter binary
*.psd -filter binary
*.ai -filter binary

# ============ 构建产物 (禁用 LFS) ============
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.csv -filter -diff -merge text
*.xml -filter -diff -merge text
*.json -filter -diff -merge text
*.txt -filter -diff -merge text
*.TXT -filter -diff -merge text
*.h -filter -diff -merge text
*.cpp -filter -diff -merge text
*.c -filter -diff -merge text
*.cc -filter -diff -merge text
*.hpp -filter -diff -merge text
*.java -filter -diff -merge text
*.lua -filter -diff -merge text
*.py -filter -diff -merge text
*.js -filter -diff -merge text
*.ts -filter -diff -merge text
*.sh -filter -diff -merge text eol=lf
*.bat -filter -diff -merge text eol=crlf
*.ps1 -filter -diff -merge text eol=lf
