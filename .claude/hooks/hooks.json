{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -File .claude/hooks/session-start-profile.ps1"
          }
        ],
        "description": "MT3 会话初始化概况"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -File .claude/hooks/pre-msbuild-guard.ps1"
          }
        ],
        "description": "MSBuild 工具集守卫（阻断非 v120）"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -File .claude/hooks/pre-git-commit-secret-guard.ps1"
          }
        ],
        "description": "git commit 前敏感信息检查守卫"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -File .claude/hooks/post-edit-generated-guard.ps1"
          }
        ],
        "description": "生成代码边界警告"
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -File .claude/hooks/post-edit-encoding-reminder.ps1"
          }
        ],
        "description": "编码一致性提醒"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -File .claude/hooks/stop-config-audit.ps1"
          }
        ],
        "description": ".claude 改动审计提醒"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -File .claude/hooks/stop-quality-gate.ps1"
          }
        ],
        "description": "当前改动集质量门禁扫描"
      }
    ]
  }
}
