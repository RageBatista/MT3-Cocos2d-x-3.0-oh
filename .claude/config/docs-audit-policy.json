{
  "schema_version": "1.1.0",
  "inventory_patterns": ["README.md", "docs/**/*.md", "plans/**/*.md"],
  "tracked_only": true,
  "docs_directory_names": ["docs"],
  "case_insensitive_directory_match": true,
  "excluded_path_segments": [".git"],
  "editorial_extensions": [".md", ".markdown", ".txt", ".rst", ".adoc", ".asciidoc", ".html", ".htm", ".dox", ".tex"],
  "near_duplicate_threshold": 0.8,
  "minimum_similarity_tokens": 200,
  "vendor_path_segments": ["node_modules", "vendor", "bower_components", "external", "third_party", "third-party-rebuild"],
  "vendor_path_prefixes": [
    "cocos2d-2.0-rc2-x-2.0.1/docs/",
    "cocos2d-x-2.2.6/docs/",
    "common/tolua++-1.0.93/",
    "dependencies/freetype-",
    "dependencies/glfw-",
    "dependencies/wxWidgets-",
    "tools/CEGUI-0.7.1/docs/",
    "tools/CEGUI-0.7.9-r5/docs/",
    "tools/free-tex-packer/docs/"
  ],
  "protected_file_name_patterns": ["LICENSE*", "COPYING*", "GPL*", "FTL*"],
  "generated_path_patterns": ["docs/generated/**"],
  "strict_markdown_utf8_no_bom_lf": true,
  "fail_on_encoding_issues": true,
  "fail_on_fence_issues": true,
  "fail_on_heading_issues": true,
  "fail_on_exact_duplicates": true
}
