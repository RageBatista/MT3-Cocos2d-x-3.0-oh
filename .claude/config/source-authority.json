{
  "schema_version": "1.1.0",
  "updated": "2026-07-12",
  "description": "MT3 治理层权威来源映射。用于区分主事实源、派生视图、桥接/sidecar、运行时真值校验点与报告产物，并声明 route/manifest/skill 校验使用的 canonical registry。",
  "artifact_classes": {
    "primary_fact_source": {
      "name": "主事实源",
      "description": "直接承载事实、规则或可执行配置真值的源文件。出现冲突时，优先以此类文件裁决。"
    },
    "derived_view": {
      "name": "派生视图",
      "description": "基于主事实源整理出的导航、索引或解释性视图，用于阅读和定位，不单独充当真值。"
    },
    "bridge_sidecar": {
      "name": "桥接/sidecar",
      "description": "为兼容、审计、导出或跨工具桥接而保留的辅助文件，不替代原生运行时入口。"
    },
    "runtime_truth_checkpoint": {
      "name": "运行时真值校验点",
      "description": "只能通过运行态命令、快照或最新状态文件验证的真值校验点。"
    },
    "report_artifact": {
      "name": "报告产物",
      "description": "由审计、验证或质量门脚本生成的报告文件，用于留痕和回归比较，不反向定义主事实。"
    }
  },
  "artifacts": [
    {
      "path": "AGENTS.md",
      "class": "primary_fact_source",
      "owner": "repository",
      "note": "跨工具统一事实入口。"
    },
    {
      "path": ".claude/RULES.md",
      "class": "primary_fact_source",
      "owner": "claude-governance",
      "note": "硬约束真值。"
    },
    {
