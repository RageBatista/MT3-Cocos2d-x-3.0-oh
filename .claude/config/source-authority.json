  "canonical_registries": {
    "route_agents": {
      "path": ".claude/config/agents.manifest.json",
      "collection": "agents",
      "id_field": "id",
      "class": "primary_fact_source"
    },
    "route_skills": {
      "path": ".claude/config/skills.manifest.json",
      "collection": "skills",
      "id_field": "id",
      "class": "primary_fact_source"
    },
    "route_workflows": {
      "path": ".claude/config/workflows.manifest.json",
      "collection": "workflows",
      "id_field": "id",
      "class": "primary_fact_source"
    },
    "route_proxies": {
      "path": ".claude/config/proxies.manifest.json",
      "collection": "proxies",
      "id_field": "id",
      "class": "primary_fact_source"
    },
    "skills_module_index": {
      "path": ".claude/config/skills.manifest.json",
      "collection": "modules",
      "id_field": "id",
      "class": "derived_view",
      "note": "技能模块聚合视图；可用于分组导航，但不能替代 route_skills 做单技能引用校验。"
    },
    "codex_workflows": {
      "path": ".codex/workflows/workflow-engine.json",
      "collection": "workflows",
      "id_field": "id",
      "class": "primary_fact_source"
    },
    "codex_agents": {
      "path": ".codex/agents/",
      "collection": "*.toml",
      "id_field": "name",
      "class": "primary_fact_source"
    },
    "codex_skills": {
      "path": ".agents/skills/",
      "collection": "*/SKILL.md",
      "id_field": "name",
      "class": "primary_fact_source"
    }
  },
  "controlled_exceptions": [
    {
      "id": "compat_entry_order_is_compact",
      "path": ".codex/compat/claude-bridge.json",
      "status": "accepted",
      "scope": "entry_order",
      "reason": "兼容桥接文件只保留最小入口顺序，不与 .claude/config/router.json 的完整 load_order 强绑定；完整顺序以 router.json + quality-gates.json + evidence-contract.json + source-authority.json 为准。"
    }
  ],
  "governance_scope": {
    "roots": [
      ".codex/**",
      ".agents/skills/**",
      ".claude/config/**",
      ".claude/scripts/**"
    ],
    "description": ".codex 全子树均须分类为原生运行入口、主事实 sidecar、审计桥接或运行证据，不允许无权威归属的配置孤岛。"
  }
}
