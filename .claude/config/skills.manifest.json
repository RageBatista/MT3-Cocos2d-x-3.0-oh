    "task_type": "任务类型。可选 analysis/implementation/review/diagnosis/documentation。",
    "module": "模块名或模块路径关键字。",
    "code_path": "代码路径（文件或目录）。",
    "log_path": "日志文件路径。",
    "service_name": "服务名（服务端模块）。",
    "protocol_file": "协议定义文件路径（如 protocol.xml）。",
    "xbean_file": "xbean 定义文件路径（如 xbean.xml）。",
    "severity": "问题严重级别。critical/high/medium/low。",
    "include_tests": "是否包含测试设计与执行建议。",
    "report_format": "报告输出格式。markdown/json/summary。",
    "channel": "渠道标识（Android 多渠道构建时使用）。"
