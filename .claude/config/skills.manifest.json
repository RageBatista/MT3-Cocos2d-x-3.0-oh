{
  "schema_version": "1.4.0",
  "updated": "2026-04-11",
  "parameter_schema": {
    "target_platform": {
      "type": "enum",
      "values": ["windows", "android", "server", "common"],
      "default": "common"
    },
    "configuration": {
      "type": "enum",
      "values": ["debug", "release", "both"],
      "default": "release"
    },
    "scope": {
      "type": "enum",
      "values": ["module", "subsystem", "project"],
      "default": "module"
    },
    "task_type": {
      "type": "enum",
      "values": ["analysis", "implementation", "review", "diagnosis", "documentation"],
      "default": "analysis"
    },
    "module": {
      "type": "string"
    },
    "code_path": {
      "type": "string"
    },
    "log_path": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "protocol_file": {
      "type": "string"
    },
    "xbean_file": {
      "type": "string"
    },
    "severity": {
      "type": "enum",
      "values": ["critical", "high", "medium", "low"],
      "default": "medium"
    },
    "include_tests": {
      "type": "boolean",
      "default": true
    },
    "report_format": {
      "type": "enum",
      "values": ["markdown", "json", "summary"],
      "default": "markdown"
    },
    "channel": {
      "type": "string"
    }
  },
  "parameter_help_zh": {
    "target_platform": "目标平台。可选 windows/android/server/common。",
    "configuration": "构建配置。可选 debug/release/both。",
