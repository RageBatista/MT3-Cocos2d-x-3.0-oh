  "recent_retrospective_findings": [
    {
      "id": "worktree-identity-first",
      "lesson": "迁移任务常同时存在 E:/MT3 与 E:/MT3-c226-shadow；任何 git/文档/入库动作前必须输出 root、branch、status。",
      "minimum_probe": [
        "git rev-parse --show-toplevel",
        "git branch --show-current",
        "git status --short --branch"
      ]
    },
    {
      "id": "cegui-vendor-not-build-output",
      "lesson": "tools/CEGUI-0.7.1 同时包含 vendor 源码、预编译依赖、历史 lib 输出和 shadow-build 产物；不能用 /tools/ 一刀切忽略或放开。",
      "minimum_probe": [
        "git ls-files --others --exclude-standard -- tools/CEGUI-0.7.1",
        "git ls-files --others -i --exclude-standard -- tools/CEGUI-0.7.1",
        "git add -n -- tools/CEGUI-0.7.1"
      ]
    },
    {
      "id": "sparse-checkout-index-boundary",
      "lesson": "sparse-checkout 会让存在于磁盘的路径无法更新索引；dry-run 出现 outside sparse warning 时必须先治理 sparse 定义。",
      "minimum_probe": [
        "git sparse-checkout list",
        "git config --get core.sparseCheckout",
        "git config --get core.sparseCheckoutCone"
      ]
    },
    {
      "id": "line-ending-attributes-before-add",
      "lesson": "core.autocrlf=true 下，真实 git add 才会暴露 LF/CRLF 风险；vendor snapshot 和文档应先设置 .gitattributes 再入索引。",
      "minimum_probe": [
        "git check-attr -a -- <path>",
        "git add -n -- <path>",
        "git diff --cached --check -- <governed-docs>"
      ]
    },
    {
      "id": "parallel-tool-race",
      "lesson": "重置、暂存和 diff --cached 验证不能并行；涉及索引状态的命令必须顺序执行。",
      "minimum_probe": [
        "先 git add",
        "再 git diff --cached --check",
        "最后 git diff --cached --name-only"
      ]
    }
  ]
}
