{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mt3.local/schemas/workflow-catalog.schema.json",
  "title": "MT3 Codex workflow catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "version",
    "updated",
    "status",
    "execution_contract",
    "authority",
    "global_rules",
    "workflows"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/workflow-catalog.schema.json"
    },
    "kind": {
      "const": "workflow-catalog"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "workflow-governance-sidecar"
    },
    "execution_contract": {
      "$ref": "#/$defs/executionContract"
    },
    "authority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "global_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/workflow"
      },
      "allOf": [
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "win32-build" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "android-build" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "server-ant-build" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "lua-ui-integration" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "cegui-layout-integration" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "resource-packaging" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "sprite-pack-algorithm" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "codex-governance" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "cocos-cegui-shadow-migration" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "application-core-flow" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "runtime-crash" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "ios-platform" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "resource-name-path-recovery" } } } }
      ]
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "nodeIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "executionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "automatic_execution",
        "default_working_directory",
        "variable_syntax",
        "result_states",
        "notes"
      ],
      "properties": {
        "executor": { "const": "human-or-agent" },
        "automatic_execution": { "const": false },
        "default_working_directory": { "const": "." },
        "variable_syntax": { "const": "${inputs.<name>}" },
        "result_states": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["PASS", "WARN", "FAIL", "BLOCKED", "EXTERNAL_REQUIRED"]
          }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "domain",
        "status",
        "execution_mode",
        "summary",
        "triggers",
        "routing",
        "inputs",
        "entry_node",
        "nodes",
        "compatibility"
      ],
      "properties": {
        "id": {
          "enum": [
            "win32-build",
            "android-build",
            "server-ant-build",
            "lua-ui-integration",
            "cegui-layout-integration",
            "resource-packaging",
            "sprite-pack-algorithm",
            "codex-governance",
            "cocos-cegui-shadow-migration",
            "application-core-flow",
            "runtime-crash",
            "ios-platform",
            "resource-name-path-recovery"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "domain": { "$ref": "#/$defs/identifier" },
        "status": { "const": "active" },
        "execution_mode": {
          "enum": ["assisted", "manual-assisted", "external-platform"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "triggers": { "$ref": "#/$defs/triggers" },
        "routing": { "$ref": "#/$defs/routing" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/input" }
        },
        "entry_node": { "$ref": "#/$defs/nodeIdentifier" },
        "nodes": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": { "$ref": "#/$defs/nodeIdentifier" },
          "additionalProperties": { "$ref": "#/$defs/node" }
        },
        "compatibility": { "$ref": "#/$defs/compatibility" }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "keywords", "negative_keywords", "path_globs"],
      "properties": {
        "priority": { "type": "integer", "minimum": 1, "maximum": 100 },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "negative_keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "path_globs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_agent", "supporting_agents", "required_skills", "optional_runtime_skills"],
      "properties": {
        "primary_agent": { "$ref": "#/$defs/identifier" },
        "supporting_agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "required_skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "optional_runtime_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description", "required", "sensitive"],
      "properties": {
        "type": { "enum": ["string", "boolean", "integer", "path"] },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude_workflow_ids", "legacy_ids"],
      "properties": {
        "claude_workflow_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "legacy_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edge": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "required"],
      "properties": {
        "type": {
          "enum": ["command-output", "artifact", "diff", "log", "manual-check", "path-check"]
        },
        "source": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "instructions"],
      "properties": {
        "mode": { "enum": ["not_required", "manual", "command"] },
        "instructions": { "type": "string", "minLength": 1 },
        "command": { "$ref": "#/$defs/command" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "command" } }, "required": ["mode"] },
          "then": { "required": ["command"] }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "operator", "value"],
      "properties": {
        "input": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "operator": { "enum": ["equals", "not_equals"] },
        "value": {}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "entry_kind",
        "entry",
        "arguments",
        "working_directory",
        "availability"
      ],
      "properties": {
        "runner": { "enum": ["powershell", "python", "external"] },
        "entry_kind": { "enum": ["repo_script", "external_command"] },
        "entry": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "working_directory": { "$ref": "#/$defs/repositoryPath" },
        "availability": {
          "enum": ["tracked_required", "runtime_workspace_local", "environment_required", "external_platform"]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["windows", "macos", "linux"] }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "enum": ["command", "gate", "manual", "handoff", "terminal"] },
        "summary": { "type": "string", "minLength": 1 },
        "mutates_workspace": { "type": "boolean" },
        "command": { "$ref": "#/$defs/command" },
        "target_agent": { "$ref": "#/$defs/identifier" },
        "when": { "$ref": "#/$defs/condition" },
        "on_success": { "$ref": "#/$defs/edge" },
        "on_failure": { "$ref": "#/$defs/edge" },
        "on_skip": { "$ref": "#/$defs/edge" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "rollback": { "$ref": "#/$defs/rollback" },
        "result": { "enum": ["PASS", "WARN", "FAIL", "BLOCKED", "EXTERNAL_REQUIRED"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "terminal" } }, "required": ["kind"] },
          "then": {
            "required": ["result"],
            "properties": {
              "on_success": false,
              "on_failure": false,
              "on_skip": false,
              "command": false,
              "when": false,
              "target_agent": false
            }
          },
          "else": {
            "required": ["mutates_workspace", "evidence", "rollback", "on_success", "on_failure"]
          }
        },
        {
          "if": { "properties": { "kind": { "const": "command" } }, "required": ["kind"] },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "kind": { "const": "handoff" } }, "required": ["kind"] },
          "then": { "required": ["target_agent"] }
        },
        {
          "if": { "required": ["when"] },
          "then": { "required": ["on_skip"] }
        }
      ]
    }
  }
}
