{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mt3.local/schemas/project-map.schema.json",
  "title": "MT3 Codex project map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "version",
    "updated",
    "status",
    "project",
    "authority_order",
    "runtime_architecture",
    "task_domains",
    "directories",
    "toolchains",
    "core_dependencies",
    "generated_code_boundaries",
    "path_availability",
    "build_entrypoints",
    "verification_entrypoints",
    "recent_retrospective_findings"
  ],
  "properties": {
    "$schema": { "const": "schemas/project-map.schema.json" },
    "kind": { "const": "project-map" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "format": "date" },
    "status": { "enum": ["authoritative-sidecar", "governance-sidecar"] },
    "project": { "$ref": "#/$defs/project" },
    "authority_order": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "runtime_architecture": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/architectureLayer" }
    },
    "task_domains": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/taskDomain" }
    },
    "directories": {
      "type": "array",
      "minItems": 15,
      "items": { "$ref": "#/$defs/directory" },
      "allOf": [
        { "contains": { "type": "object", "required": ["path", "modification_policy"], "properties": { "path": { "const": "cocos2d-x-2.2.6" }, "modification_policy": { "const": "first-party-high-risk" } } } },
        { "contains": { "type": "object", "required": ["path", "modification_policy"], "properties": { "path": { "const": "cocos2d-2.0-rc2-x-2.0.1" }, "modification_policy": { "const": "historical-read-only" } } } },
        { "contains": { "type": "object", "required": ["path", "modification_policy"], "properties": { "path": { "const": "dependencies" }, "modification_policy": { "const": "vendor-read-only" } } } },
        { "contains": { "type": "object", "required": ["path", "availability"], "properties": { "path": { "const": "client/resource/res/ui" }, "availability": { "const": "runtime_workspace_local" } } } }
      ]
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["win32", "android", "ios", "server"],
      "properties": {
        "win32": { "$ref": "#/$defs/toolchain" },
        "android": { "$ref": "#/$defs/toolchain" },
        "ios": { "$ref": "#/$defs/toolchain" },
        "server": { "$ref": "#/$defs/toolchain" }
      }
    },
    "core_dependencies": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "generated_code_boundaries": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/generatedBoundary" }
    },
    "path_availability": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/pathAvailability" },
      "allOf": [
        { "contains": { "type": "object", "required": ["locator", "classification"], "properties": { "locator": { "const": "client/resource/res/ui" }, "classification": { "const": "runtime_workspace_local" } } } },
        { "contains": { "type": "object", "required": ["locator", "classification"], "properties": { "locator": { "const": "client/android/LocojoyProject/assets/res" }, "classification": { "const": "generated_may_be_absent" } } } },
        { "contains": { "type": "object", "required": ["locator", "classification"], "properties": { "locator": { "const": "tools/CEGUI-0.7.1" }, "classification": { "const": "runtime_workspace_local" } } } },
        { "contains": { "type": "object", "required": ["locator", "classification"], "properties": { "locator": { "const": "xcodebuild" }, "classification": { "const": "external_platform" } } } }
      ]
    },
    "build_entrypoints": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/buildEntrypoint" },
      "allOf": [
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "win32-canonical" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "android-canonical" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "ios-xcodebuild" } } } },
        { "contains": { "type": "object", "required": ["id"], "properties": { "id": { "const": "server-ant" } } } }
      ]
    },
    "verification_entrypoints": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/verificationEntrypoint" }
    },
    "recent_retrospective_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/retrospectiveFinding" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$"
    },
    "availability": {
      "enum": [
        "tracked_required",
        "runtime_workspace_local",
        "generated_may_be_absent",
        "environment_required",
        "external_platform"
      ]
    },
    "modificationPolicy": {
      "enum": [
        "first-party-editable",
        "first-party-high-risk",
        "historical-read-only",
        "vendor-read-only",
        "governance-editable"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "primary_clients", "server", "rendering_stack", "scale_notes"],
      "properties": {
        "name": { "const": "MT3" },
        "type": { "type": "string", "minLength": 1 },
        "primary_clients": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["Win32", "Android", "iOS"] }
        },
        "server": { "type": "string", "minLength": 1 },
        "rendering_stack": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "scale_notes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "architectureLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "name", "paths", "responsibilities"],
      "properties": {
        "layer": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "taskDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "primary_paths", "skill", "agent", "workflow_ids", "boundary"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "primary_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "skill": { "$ref": "#/$defs/identifier" },
        "agent": { "$ref": "#/$defs/identifier" },
        "supporting_agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "workflow_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "modifiable", "modification_policy", "availability"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "role": { "type": "string", "minLength": 1 },
        "modifiable": { "type": "boolean" },
        "modification_policy": { "$ref": "#/$defs/modificationPolicy" },
        "availability": { "$ref": "#/$defs/availability" },
        "encoding_note": { "type": "string", "minLength": 1 },
        "build_impact": { "type": "string", "minLength": 1 },
        "skill": { "$ref": "#/$defs/identifier" },
        "toolchain": { "type": "string", "minLength": 1 },
        "project": { "$ref": "#/$defs/repositoryPath" },
        "entrypoints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "bridge_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "boundary": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "forbidden_defaults", "executor_availability"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_defaults": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "executor_availability": {
          "enum": ["current_host", "environment_required", "external_platform"]
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_or_line", "paths"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version_or_line": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "generatedBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "classification", "availability", "source_roots", "source_action", "workflow_id"],
      "properties": {
        "pattern": { "$ref": "#/$defs/repositoryPath" },
        "classification": { "const": "generated-read-only" },
        "availability": { "$ref": "#/$defs/availability" },
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "source_action": { "type": "string", "minLength": 1 },
        "workflow_id": { "$ref": "#/$defs/identifier" },
        "generator_entrypoint_id": { "$ref": "#/$defs/identifier" },
        "staging_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "pathAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "locator_kind", "classification", "validation", "required_by_workflow_ids"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "locator_kind": { "enum": ["repository_path", "external_command"] },
        "classification": { "$ref": "#/$defs/availability" },
        "validation": { "type": "string", "minLength": 1 },
        "required_by_workflow_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "buildEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "workflow_id",
        "platform",
        "runner",
        "entry_kind",
        "entry",
        "arguments",
        "working_directory",
        "role",
        "availability",
        "executor_availability",
        "verified",
        "notes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "workflow_id": { "$ref": "#/$defs/identifier" },
        "platform": { "enum": ["win32", "android", "ios", "server", "resource", "cross-platform"] },
        "runner": { "enum": ["powershell", "ant", "xcodebuild", "manual"] },
        "entry_kind": { "enum": ["repo_script", "repo_build_file", "runtime_local_script", "external_command", "manual_tool"] },
        "entry": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "working_directory": { "$ref": "#/$defs/repositoryPath" },
        "role": { "enum": ["preflight", "canonical_build", "internal_dependency", "resource_pack", "external_build", "manual_build"] },
        "availability": { "$ref": "#/$defs/availability" },
        "executor_availability": { "enum": ["current_host", "environment_required", "runtime_workspace_local", "external_platform"] },
        "verified": { "type": "boolean" },
        "build_file": { "$ref": "#/$defs/repositoryPath" },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "verificationEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runner", "entry", "arguments", "availability", "mutates_reports"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "runner": { "const": "powershell" },
        "entry": { "$ref": "#/$defs/repositoryPath" },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "availability": { "const": "tracked_required" },
        "mutates_reports": { "type": "boolean" }
      }
    },
    "retrospectiveFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lesson", "minimum_probe"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "lesson": { "type": "string", "minLength": 1 },
        "minimum_probe": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
