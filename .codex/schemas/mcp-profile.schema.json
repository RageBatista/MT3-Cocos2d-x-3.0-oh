{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "kind", "schema_version", "updated", "runtime_effect", "automatic_runtime_switching", "known_servers", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "mcp-profile-catalog" },
    "schema_version": { "const": "2.0.0" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "runtime_effect": { "const": "none" },
    "automatic_runtime_switching": { "const": false },
    "known_servers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "aliases", "enable", "disable", "required_configured", "startup_timeout_sec", "tool_timeout_sec"],
        "properties": {
          "id": { "enum": ["none", "official-docs", "research", "browser-debug"] },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "enable": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "disable": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "required_configured": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "startup_timeout_sec": { "type": "integer", "minimum": 1, "maximum": 60 },
          "tool_timeout_sec": { "type": "integer", "minimum": 1, "maximum": 300 }
        }
      }
    }
  }
}
