# 环境变量文件（包含敏感信息，绝不能提交）
.env
.env.local
.env.*.local

# 日志文件
runtime/log/*
!runtime/log/.gitkeep

# 缓存文件
runtime/cache/*
!runtime/cache/.gitkeep

# 临时文件
runtime/temp/*
!runtime/temp/.gitkeep

# 编译和构建文件
*.log
*.cache
*.tmp

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# IDE配置文件
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# 备份文件
*.bak
*.backup
*.old
