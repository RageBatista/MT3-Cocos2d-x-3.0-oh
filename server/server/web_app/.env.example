# Environment variables template
# Keep this file committed and place real secrets in .env.local

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mhxy
DB_USER=CHANGE_ME_DB_USER
DB_PASS=CHANGE_ME_DB_PASS
DB_CHARSET=utf8mb4

# JMX auth
JMX_AUTH_ENABLED=true
JMX_USERNAME=super_admin
JMX_PASSWORD=CHANGE_ME_JMX_PASSWORD
JMX_TOKEN=CHANGE_ME_JMX_TOKEN

# Admin security
MASTER_VERIFY_PASSWORD=CHANGE_ME_MASTER_VERIFY_PASSWORD

# Player auth
PLAYER_AUTH_ENABLED=true
OP_SECRET_SALT=CHANGE_ME_OP_SECRET_SALT
SIGNATURE_TIMEOUT=300
ITEM_WHITELIST_CACHE_TTL=3600
PET_WHITELIST_CACHE_TTL=3600
TCP_DIRECT_ENABLED=true

# Admin auth
ADMIN_AUTH_SECRET_KEY=CHANGE_ME_ADMIN_AUTH_SECRET_KEY

# App
APP_DEBUG=false
APP_ENV=production
COOKIE_SECURE=0

# API compatibility
# bind 接口是否保持旧版标量返回（1=返回"0/1"，0=返回标准JSON）
API_BIND_LEGACY_SCALAR=0
# rebate 关闭时是否保持旧版纯文本返回（1=纯文本，0=notify JSON）
API_REBATE_LEGACY_TEXT=0
# sdk 接口是否保持旧版原始JSON字符串返回（1=原始字符串，0=标准JSON）
API_SDK_LEGACY_RAW=0
# getpayitem 是否保持旧版原始数组JSON返回（1=原始数组，0={"code":1,"data":[...]})
API_PAYITEM_LEGACY_RAW=0
