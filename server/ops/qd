                fi
                if [ -d "/home/game/server${step}/game_server/mkdb" ] 
                then
                    cd /home/game/server${step}/game_server/logs && rm -f *.log 
                    cd /home/game/server${step}/game_server/mkdb && rm -f *.log 
                    zip -r /home/db_bak/now/server${step}_game_server.zip /home/game/server${step}/game_server/mkdb
                    cp /home/db_bak/now/server${step}_game_server.zip $common
                fi
                if [ -d "/home/game/server${step}/game_server/mbackup" ] 
                then
                    rm -rf /home/game/server${step}/game_server/mbackup/*
                fi
