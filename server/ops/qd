            show_zone_status "$step" || true
        fi
        step=$((step + 1))
    done
}

# 检查服务状态
check_service_status() {
    local port=$1
    local service_name=$2
    if netstat -lnp | grep -q ":$port "; then
        printf "${GREEN}✓ ${service_name} 运行中 (端口: $port)${NC}\n"
        return 0
    else
        printf "${RED}✗ ${service_name} 未运行${NC}\n"
        return 1
    fi
}

# 启动服务函数
start_service() {
    local service_name=$1
    local command=$2
    local work_dir=$3
    local log_file=$4
    
    printf "${CYAN}正在启动${service_name}...${NC}\n"
    
    # 检查工作目录
    if [ ! -d "$work_dir" ]; then
        handle_error "工作目录不存在: $work_dir"
    fi
    
    cd "$work_dir" || handle_error "无法进入目录: $work_dir"
    
    # 启动服务
    if [ -n "$log_file" ]; then
        nohup $command > "$log_file" 2>&1 &
    else
        nohup $command > /dev/null 2>&1 &
    fi
    
    local pid=$!
    
    # 等待服务启动
    local retry=0
    while [ $retry -lt 5 ]; do
        if ps -p $pid > /dev/null; then
            log_message "INFO" "${service_name}启动成功"
            return 0
        fi
        sleep 1
        ((retry++))
    done
    
    handle_error "${service_name}启动失败"
    return 1
}

# 关闭服务函数
stop_service() {
    local service_name=$1
    local port=$2
    local force=$3
    
    printf "${CYAN}正在关闭${service_name}...${NC}\n"
    local pid=$(netstat -nlp | grep ":$port " | awk '{print $7}' | cut -d'/' -f1)
    
    if [ -n "$pid" ]; then
        if [ "$force" = "true" ]; then
            kill -9 $pid
            progress_bar 1 "强制关闭${service_name}"
        else
            kill $pid
            progress_bar 2 "正常关闭${service_name}"
        fi
        log_message "INFO" "${service_name}关闭成功"
        return 0
    else
        printf "${YELLOW}${service_name}未运行${NC}\n"
        return 1
    fi
}

# 通过端口获取PID（去重）
get_pids_by_port() {
    local port=$1
    netstat -nlp 2>/dev/null | awk -v p="$port" '$4 ~ (":" p "$") {split($7,a,"/"); if (a[1] ~ /^[0-9]+$/) print a[1]}' | sort -u
}

is_port_listening() {
    local port=$1
    [ -n "$(get_pids_by_port "$port")" ]
}

get_file_size_bytes() {
    local file_path=$1
    if [ -f "$file_path" ]; then
        stat -c %s "$file_path" 2>/dev/null || echo 0
    else
        echo 0
    fi
}

log_contains_since_offset() {
    local file_path=$1
    local byte_offset=$2
    local pattern=$3
    local current_size

    if [ ! -f "$file_path" ]; then
        return 1
    fi

    current_size=$(get_file_size_bytes "$file_path")
    if [ "$current_size" -lt "$byte_offset" ]; then
        byte_offset=0
    fi

    if [ "$byte_offset" -gt 0 ]; then
        tail -c +$((byte_offset + 1)) "$file_path" 2>/dev/null | grep -F -q "$pattern"
    else
        grep -F -q "$pattern" "$file_path" 2>/dev/null
    fi
}

wait_for_port_listen() {
    local port=$1
    local service_name=$2
    local timeout_seconds=${3:-30}
    local waited=0

    while [ "$waited" -lt "$timeout_seconds" ]; do
        if is_port_listening "$port"; then
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    printf "${RED}${service_name}未在 ${timeout_seconds}s 内监听端口 ${port}${NC}\n"
    return 1
}

print_waiting_frame() {
    local frame_index=$1
    local message=$2
    local spinner=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local colors=("${CYAN}" "${BLUE}" "${PURPLE}" "${GREEN}")
    local color_idx=$((frame_index % ${#colors[@]}))
    local spinner_idx=$((frame_index % ${#spinner[@]}))

    printf "\r\033[K${colors[$color_idx]}[%s]${NC} %s" "${spinner[$spinner_idx]}" "$message"
}

finish_waiting_frame() {
    local message=$1
    printf "\r\033[K${GREEN}[✓]${NC} %s\n" "$message"
}

fail_waiting_frame() {
    local message=$1
    printf "\r\033[K${RED}[✗]${NC} %s\n" "$message"
}

wait_for_port_listen_with_feedback() {
    local port=$1
    local service_name=$2
    local timeout_seconds=${3:-30}
    local waited=0
    local frame_index=0

    if [ ! -t 1 ]; then
        wait_for_port_listen "$port" "$service_name" "$timeout_seconds"
        return $?
    fi

    while [ "$waited" -lt "$timeout_seconds" ]; do
        if is_port_listening "$port"; then
            finish_waiting_frame "${service_name}已就绪 (端口: ${port})"
            return 0
        fi
        print_waiting_frame "$frame_index" "${service_name}启动中... (端口: ${port})"
        sleep 1
        waited=$((waited + 1))
        frame_index=$((frame_index + 1))
    done

    fail_waiting_frame "${service_name}未在 ${timeout_seconds}s 内监听端口 ${port}"
    return 1
}

is_zone_startup_ready() {
    local zone_number=$1
    local zone_log=$2
    local zone_log_offset=$3
    local gmport=$((zone_number + 41000))
    local gateport=$((zone_number + 42000))
    local provider_port=$((zone_number + 43000))
    local delivery_port=$((zone_number + 44000))
    local game_db_port=$((zone_number + 45000))

    if is_port_listening "$gmport" \
        && is_port_listening "$gateport" \
        && is_port_listening "$provider_port" \
        && is_port_listening "$delivery_port" \
        && is_port_listening "$game_db_port" \
        && log_contains_since_offset "$zone_log" "$zone_log_offset" "SERVER OPENED!"; then
        return 0
    fi

    return 1
}

wait_for_zone_startup() {
    local zone_number=$1
    local zone_log=$2
    local zone_log_offset=$3
    local timeout_seconds=${4:-90}
    local waited=0

    while [ "$waited" -lt "$timeout_seconds" ]; do
        if is_zone_startup_ready "$zone_number" "$zone_log" "$zone_log_offset"; then
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    printf "${RED}大区 %s 未在 %ss 内完成启动，请检查 %s${NC}\n" "$zone_number" "$timeout_seconds" "$zone_log"
    return 1
}

wait_for_zone_startup_with_feedback() {
    local zone_number=$1
    local zone_log=$2
    local zone_log_offset=$3
    local timeout_seconds=${4:-90}
    local waited=0
    local frame_index=0

    if [ ! -t 1 ]; then
        wait_for_zone_startup "$zone_number" "$zone_log" "$zone_log_offset" "$timeout_seconds"
        return $?
    fi

    while [ "$waited" -lt "$timeout_seconds" ]; do
        if is_zone_startup_ready "$zone_number" "$zone_log" "$zone_log_offset"; then
            finish_waiting_frame "大区 ${zone_number} 已完成启动"
            return 0
        fi
        print_waiting_frame "$frame_index" "正在等待大区 ${zone_number} 完成启动..."
        sleep 1
        waited=$((waited + 1))
        frame_index=$((frame_index + 1))
    done

    fail_waiting_frame "大区 ${zone_number} 未在 ${timeout_seconds}s 内完成启动"
    return 1
}

# 按端口关闭服务
stop_service_by_port() {
    local service_name=$1
    local port=$2
    local force=$3
    local pids
    pids=$(get_pids_by_port "$port")

    if [ -z "$pids" ]; then
        printf "${YELLOW}${service_name}未运行 (端口: ${port})${NC}\n"
        return 1
    fi

    printf "${CYAN}正在关闭${service_name} (端口: ${port})...${NC}\n"
    if [ "$force" = "true" ]; then
        kill -9 $pids
        progress_bar 1 "强制关闭${service_name}"
    else
        kill $pids
        sleep 1
        # 温和关闭失败时兜底强杀
        local remain
        remain=$(get_pids_by_port "$port")
        if [ -n "$remain" ]; then
            kill -9 $remain
        fi
        progress_bar 2 "关闭${service_name}"
    fi
    return 0
}

# 检查指定大区是否已完全关闭（按关键端口）
is_zone_fully_closed() {
    local zone_number=$1
    local gmport=$((zone_number + 41000))
    local gateport=$((zone_number + 42000))
    local provider_port=$((zone_number + 43000))
    local delivery_port=$((zone_number + 44000))
    local game_db_port=$((zone_number + 45000))

    if [ -n "$(get_pids_by_port "$gmport")" ]; then
        return 1
    fi
    if [ -n "$(get_pids_by_port "$gateport")" ]; then
        return 1
    fi
    if [ -n "$(get_pids_by_port "$provider_port")" ]; then
        return 1
    fi
    if [ -n "$(get_pids_by_port "$delivery_port")" ]; then
        return 1
    fi
    if [ -n "$(get_pids_by_port "$game_db_port")" ]; then
        return 1
    fi
    return 0
}

# 清理公共区域运行数据
clear_common_data() {
    local sdk_mkdb="/home/game/common/sdk_server/mkdb"
    local name_nsdb="/home/game/common/name_server/nsdb"
    local cleaned_count=0

    printf "${CYAN}正在清理公共区域数据...${NC}\n"

    if [ -d "$sdk_mkdb" ]; then
        rm -rf "$sdk_mkdb"/*
        cleaned_count=$((cleaned_count + 1))
        printf "${GREEN}已清理：%s${NC}\n" "$sdk_mkdb"
    else
        printf "${YELLOW}目录不存在，已跳过：%s${NC}\n" "$sdk_mkdb"
    fi

    if [ -d "$name_nsdb" ]; then
        rm -rf "$name_nsdb"/*
        cleaned_count=$((cleaned_count + 1))
        printf "${GREEN}已清理：%s${NC}\n" "$name_nsdb"
    else
        printf "${YELLOW}目录不存在，已跳过：%s${NC}\n" "$name_nsdb"
    fi

    if [ "$cleaned_count" -eq 0 ]; then
        handle_error "未找到可清理的公共区域数据目录"
    fi

    log_message "INFO" "公共区域删档完成: $sdk_mkdb, $name_nsdb"
    printf "${GREEN}公共区域删档完成！${NC}\n"
}

