        "gm")
            print_title "GM命令调试" "${YELLOW}"
            printf "${CYAN}请输入要调试的大区ID (1-99): ${NC}"
            read zone_id
            
            # 验证大区ID
            if ! [[ "$zone_id" =~ ^[1-9][0-9]?$ ]] || [ "$zone_id" -gt 99 ]; then
                handle_error "无效的大区ID，请输入1-99之间的数字"
            fi
            
            # 检查大区是否存在
            if [ ! -d "/home/game/server$zone_id" ]; then
                handle_error "大区 $zone_id 不存在"
            fi
            
            # 计算GM端口
            gmport=$((zone_id + 41000))
            
            # 检查服务是否运行
            if ! netstat -lnp | grep -q ":$gmport "; then
                handle_error "大区 $zone_id 未启动，请先启动大区"
            fi
            
            printf "${GREEN}大区 $zone_id 的GM端口为: $gmport${NC}\n"
            printf "${YELLOW}请输入GM命令 (输入 'exit' 退出): ${NC}"
            
            while true; do
                read -r gm_cmd
                if [ "$gm_cmd" = "exit" ]; then
                    break
                fi
                
                # 发送GM命令
                printf "${CYAN}正在执行命令: $gm_cmd${NC}\n"
                echo "$gm_cmd" | nc localhost $gmport
                
                printf "${YELLOW}请输入下一个GM命令 (输入 'exit' 退出): ${NC}"
            done
            ;;
        *)
            printf "${RED}错误：未知的命令${NC}\n"
            exit 1
            ;;
    esac
fi
