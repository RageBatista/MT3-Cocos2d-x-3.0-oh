    local gmport=$((zone_number + 41000))
    local gateport=$((zone_number + 42000))
    local provider_port=$((zone_number + 43000))
    local delivery_port=$((zone_number + 44000))
    local game_db_port=$((zone_number + 45000))
    local need_fallback=true

    # 优先走分区托管脚本，失败或残留时自动兜底
    if [ -f "$zone_qd" ]; then
        printf "${CYAN}检测到托管脚本，使用 $zone_qd 关闭大区...${NC}\n"
        if [ "$force_close" = "true" ]; then
            bash "$zone_qd" stop -f
        else
            bash "$zone_qd" stop
        fi
        if [ $? -ne 0 ]; then
            printf "${YELLOW}托管脚本返回非0，启用端口兜底关闭...${NC}\n"
        else
            # 托管脚本返回成功后，仍要确认端口已释放
            sleep 1
            local remain_pids
            remain_pids="$(get_pids_by_port "$gmport") $(get_pids_by_port "$gateport") $(get_pids_by_port "$provider_port") $(get_pids_by_port "$delivery_port") $(get_pids_by_port "$game_db_port")"
            if [ -z "$(echo "$remain_pids" | xargs -n1 2>/dev/null | sort -u | tr -d '[:space:]')" ]; then
                need_fallback=false
            else
                printf "${YELLOW}检测到托管脚本后仍有残留进程，启用端口兜底关闭...${NC}\n"
            fi
        fi
    fi

    if [ "$need_fallback" = "false" ]; then
        printf "${GREEN}大区 $zone_number 已成功关闭！${NC}\n"
        log_message "INFO" "大区 $zone_number 关闭成功（托管脚本）"
        return 0
    fi

    printf "${YELLOW}正在关闭大区 $zone_number...${NC}\n"    
    # 基于端口兜底关闭，避免依赖命令行中必须包含 serverN
    stop_service_by_port "游戏GM服务" "$gmport" "$force_close" || true
    stop_service_by_port "网关服务" "$gateport" "$force_close" || true
    stop_service_by_port "代理连接服务" "$provider_port" "$force_close" || true
    stop_service_by_port "代理业务服务" "$delivery_port" "$force_close" || true
    stop_service_by_port "游戏数据库服务" "$game_db_port" "$force_close" || true

    # 兼容旧进程：按GM端口参数定位当前大区Java进程
    local pids
    pids=$(ps -ef | grep "gsxdb.jar" | grep " -rmiport $gmport" | grep -v grep | awk '{print $2}')
    [ -n "$pids" ] && kill -9 $pids 2>/dev/null || true

    # 验证所有服务是否已关闭
    sleep 2
    local services_running=0
    if [ -n "$(get_pids_by_port "$gmport")" ]; then
        printf "${RED}警告：游戏GM服务仍在运行 (端口: ${gmport})${NC}\n"
        services_running=1
    fi
    if [ -n "$(get_pids_by_port "$gateport")" ]; then
        printf "${RED}警告：网关服务仍在运行${NC}\n"
        services_running=1
    fi
    if [ -n "$(get_pids_by_port "$provider_port")" ] || [ -n "$(get_pids_by_port "$delivery_port")" ]; then
        printf "${RED}警告：代理服务仍在运行${NC}\n"
        services_running=1
    fi
    if [ -n "$(get_pids_by_port "$game_db_port")" ]; then
        printf "${RED}警告：游戏数据库服务仍在运行 (端口: ${game_db_port})${NC}\n"
        services_running=1
    fi
    if [ $services_running -eq 0 ]; then
        printf "${GREEN}大区 $zone_number 已成功关闭！${NC}\n"
        log_message "INFO" "大区 $zone_number 关闭成功"
        return 0
    else
        printf "${YELLOW}警告：部分服务可能未完全关闭，请手动检查${NC}\n"
        log_message "WARN" "大区 $zone_number 部分服务未完全关闭"
        return 1
    fi
}

