}

show_zone_status() {
    local zone_number=$1
    local zone_dir="/home/game/server$zone_number"
    local zone_qd="$zone_dir/qd.sh"

    if [ ! -d "$zone_dir" ]; then
        printf "${RED}大区 %s 不存在${NC}\n" "$zone_number"
