    fi

    check_service_status "$((zone_number + 41000))" "游戏GM服务" || true
    check_service_status "$((zone_number + 42000))" "网关服务" || true
    check_service_status "$((zone_number + 44000))" "代理服务" || true
}

show_status() {
    local zone_filter=${1:-}
    print_title "服务状态" "${CYAN}"
    print_title "公共服务" "${GREEN}"
    show_common_status || true

    if [ -n "$zone_filter" ]; then
        print_title "大区 ${zone_filter}" "${GREEN}"
