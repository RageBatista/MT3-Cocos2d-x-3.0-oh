                mkdir /home/db_bak
            fi
            if [ ! -d "/home/db_bak/now" ]
            then
                mkdir /home/db_bak/now
            else
                rm -rf /home/db_bak/now/*
            fi
            
            if [ ! -d "/home/db_bak" ]
            then
                mkdir /home/db_bak
            fi
            
            cur_date="`date +%Y%m%d`"
            cur_time="`date +%H%M%S`"
            step=1
            while [ -d "/home/game/server${step}" ] 
            do
                if [ -d "/home/game/server${step}" ] 
                then
                    if [ ! -d "/home/db_bak/server${step}" ] 
                    then
                        mkdir /home/db_bak/server${step}
                    fi
                    common="/home/db_bak/server${step}/${cur_date}${cur_time}server${step}"
