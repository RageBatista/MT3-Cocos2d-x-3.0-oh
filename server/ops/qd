# 颜色定义
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly PURPLE='\033[0;35m'
readonly CYAN='\033[0;36m'
readonly WHITE='\033[1;37m'
readonly BOLD='\033[1m'
readonly NC='\033[0m'

# 常量定义
readonly GAME_HOME="/home/game"
readonly LOG_FILE="/home/game/script.log"
readonly LOCK_DIR="/var/lock/mt3-qd.lock.d"
readonly MAX_ZONE=99
QD_LOCK_HELD=0

# 日志函数
log_message() {
    local level=$1
    local message=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    # 确保日志目录存在
    mkdir -p "$(dirname "$LOG_FILE")"
    
    # 日志轮转（如果超过10MB）
    if [ -f "$LOG_FILE" ] && [ $(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0) -gt 10485760 ]; then
        mv "$LOG_FILE" "${LOG_FILE}.$(date +%Y%m%d%H%M%S)"
    fi
    
    echo "[$timestamp] [$level] $message" >> "$LOG_FILE"
}

# 错误处理函数
handle_error() {
    local error_msg=$1
    local exit_code=${2:-1}
    local error_type=${3:-"ERROR"}
    
    printf "${RED}${error_type}：${error_msg}${NC}\n"
    log_message "$error_type" "$error_msg"
    
    # 添加错误追踪
    if [ "$error_type" = "ERROR" ]; then
        printf "${RED}错误位置：${BASH_SOURCE[1]}:${BASH_LINENO[0]}${NC}\n"
    fi
    
    exit $exit_code
}

# 检查权限
check_permissions() {
    # 检查root权限
    if [ "$(id -u)" != "0" ]; then
        handle_error "此脚本需要root权限运行" 1
    fi
    
    # 检查关键目录权限
    local dirs=("$GAME_HOME" "/home/game/common" "/home/game/server1")
    for dir in "${dirs[@]}"; do
        if [ ! -d "$dir" ]; then
            handle_error "目录不存在: $dir" 1
        fi
        if [ ! -r "$dir" ] || [ ! -w "$dir" ]; then
            handle_error "目录权限不足: $dir" 1
        fi
    done
}

# 检查目录是否存在
check_directory() {
    local dir=$1
    local desc=$2
    if [ ! -d "$dir" ]; then
        handle_error "$desc目录不存在: $dir" 1
    fi
}

# 确认操作
confirm_operation() {
    local message=$1
    local force=${2:-false}
    
    if [ "$force" = "true" ]; then
        return 0
    fi
    
    printf "${YELLOW}${message} (y/N): ${NC}"
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        printf "${RED}操作已取消${NC}\n"
        exit 0
    fi
}

# 进度条函数
progress_bar() {
    local duration=$1
    local prefix=$2
    local size=30
    local completed=0
    local sleep_duration=$(echo "scale=2; $duration/$size" | bc)
    
    printf "${CYAN}${prefix}${NC} ["
    for ((i=0; i<$size; i++)); do
        printf "\e[42m \e[0m"
        sleep $sleep_duration
        completed=$((i + 1))
        printf "\r${CYAN}${prefix}${NC} ["
        for ((j=0; j<=i; j++)); do
            printf "\e[42m \e[0m"
        done
        for ((j=i+1; j<$size; j++)); do
            printf " "
        done
        printf "] %3d%%" $((completed * 100 / size))
    done
    printf "\n"
}

# 打印带颜色的标题
print_title() {
    local title=$1
    local color=$2
    local width=60
    local padding=$(( (width - ${#title}) / 2 ))
    printf "\n${color}%${padding}s%s%${padding}s${NC}\n" "" "$title" ""
    printf "${color}%${width}s${NC}\n" | tr " " "="
}

# 打印菜单项
print_menu_item() {
    local key=$1
    local desc=$2
    local color=$3
    local padding=$(( 8 - ${#key} ))
    printf "${color}[%s]%${padding}s${NC} %s\n" "$key" "" "$desc"
}

# 显示加载动画
show_loading() {
    local pid=$1
    local message=$2
    local delay=0.1
    local spinner=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local colors=("${CYAN}" "${BLUE}" "${PURPLE}" "${GREEN}")
    local i=0
    local color_idx=0
    
    # 保存光标位置
    printf "\033[s"
    
    while ps -p $pid > /dev/null; do
        # 更新颜色
        color_idx=$((i % ${#colors[@]}))
        
        # 恢复光标位置
        printf "\033[u"
        
        # 显示动画和消息
        printf "${colors[$color_idx]}[%s]${NC} %s" "${spinner[$i]}" "$message"
        
        # 更新索引
        i=$(( (i + 1) % ${#spinner[@]} ))
        
        # 刷新显示
        printf "\033[K"
        
        sleep $delay
    done
    
    # 完成后的显示
    printf "\n"
    printf "${GREEN}✓ %s 完成！${NC}\n" "$message"
}

# 检查系统资源
check_system_resources() {
    # 检查内存
    local free_mem=$(free -m | awk '/Mem:/ {print $4}')
    if [ $free_mem -lt 1024 ]; then
        printf "${YELLOW}警告: 可用内存不足 1GB${NC}\n"
    fi
    
    # 检查磁盘空间
    local free_disk=$(df -h /home | awk 'NR==2 {print $4}')
    if [ "${free_disk%G}" -lt 10 ]; then
        printf "${YELLOW}警告: 磁盘空间不足 10GB${NC}\n"
      fi
  }

is_read_only_operation() {
    local operation=${1:-}
    case "$operation" in
        ""|"dk"|"status")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

acquire_operation_lock() {
    local operation=${1:-}
    if is_read_only_operation "$operation"; then
        return 0
    fi
    if [ "${QD_LOCK_HELD:-0}" = "1" ]; then
        return 0
    fi

    mkdir -p "$(dirname "$LOCK_DIR")"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        local owner_pid=""
        if [ -f "$LOCK_DIR/pid" ]; then
            owner_pid="$(tr -cd '0-9' < "$LOCK_DIR/pid" 2>/dev/null || true)"
        fi
        if [ -n "$owner_pid" ] && ! kill -0 "$owner_pid" 2>/dev/null; then
            rm -rf "$LOCK_DIR"
            if ! mkdir "$LOCK_DIR" 2>/dev/null; then
                handle_error "已有 qd 运维操作正在执行，请稍后重试" 1
            fi
        else
            handle_error "已有 qd 运维操作正在执行，请稍后重试" 1
        fi
    fi
    echo "$$" > "$LOCK_DIR/pid"
    QD_LOCK_HELD=1
    trap 'release_operation_lock' EXIT INT TERM
}

release_operation_lock() {
    if [ "${QD_LOCK_HELD:-0}" != "1" ]; then
        return 0
    fi
    local owner_pid=""
    if [ -f "$LOCK_DIR/pid" ]; then
        owner_pid="$(tr -cd '0-9' < "$LOCK_DIR/pid" 2>/dev/null || true)"
    fi
    if [ "$owner_pid" = "$$" ]; then
        rm -rf "$LOCK_DIR"
    fi
    QD_LOCK_HELD=0
}

show_common_status() {
    local common_qd="/home/game/common/qd.sh"
    if [ -f "$common_qd" ]; then
        bash "$common_qd" status
        return $?
    fi
